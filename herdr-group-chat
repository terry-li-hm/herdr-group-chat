DEFAULT_AGENTS = {
    "pi": "pi-peer",
    "claude": "claude-peer",
    "codex": "codex-peer",
    "grok": "grok-peer",
}
DEFAULT_STATE_DIR = Path("~/.local/state/herdr-group-chat")
ROOM_ENV = "HERDR_GROUP_CHAT_ROOM"
AGENTS_WORKSPACE_ENV = "HERDR_GROUP_CHAT_AGENTS_WORKSPACE_ID"
SETUP_FAILURES_ENV = "HERDR_GROUP_CHAT_SETUP_FAILURES"
ROOM_RE = re.compile(r"[a-z0-9][a-z0-9_-]{0,31}\Z")
MENTION_RE = re.compile(r"^@([a-z0-9_,@-]+)\s+(.*)$", re.DOTALL | re.IGNORECASE)
REPLY_TOKEN_RE = re.compile(r"HGCHAT_REPLY_BEGIN ([a-f0-9]{32})")
# Herdr reports agent status heuristically and flips idle->working with a lag, and a
# 240-line alternate-screen read is a scrolling capture that took ~6 s on a busy host.
# So the relay polls at a modest interval, defers the first read until the agent has been
# seen working (or a short grace period has passed), and treats a refused or slow read as
# "not ready yet" rather than as a failed turn.
POLL_INTERVAL_S = 0.5
SUBMIT_GRACE_S = 2.0
TERMINAL_READ_TIMEOUT_S = 30.0
# An agent that went back to idle/done but keeps showing the same terminal text without
# the reply markers has finished without honoring the marker protocol; after this many
# consecutive stable unmarked reads the turn fails fast instead of stalling to timeout.
STABLE_UNMARKED_POLLS = 20
TUI_TIMESTAMP_RE = re.compile(r"[ \t]{2,}\d{1,2}:\d{2}\s+[AP]M[ \t█]*(?:\n[ \t]*)?")
# Codex's unreviewed-hooks notice is the one blocking dialog the relay recovers
# from at submission time; the needle is short enough to survive the visible
# read's clipping at viewport width.
HOOK_DIALOG_NEEDLE = "trust all"
# The notice stacks at most two variants (menu over summary), each cleared by
# one esc, so a bounded esc budget plus a confirmation read covers it; a dialog
# that survives them is not this notice and stays blocked.
HOOK_RECOVERY_MAX_ESCS = 3


class ChatError(RuntimeError):
    """A user-visible relay failure."""

    def __init__(self, message: str, code: str | None = None) -> None:
        super().__init__(message)
        self.code = code


class CommandLaunchError(ChatError):
    """The Herdr command could not start, so no agent turn was submitted."""


def herdr_error_code(detail: str) -> str | None:
    """Extract Herdr's structured error code from a command failure, if any."""
    with suppress(json.JSONDecodeError, KeyError, TypeError):
        return str(json.loads(detail)["error"]["code"])
    return None


class AgentClient(Protocol):
    def live_targets(self) -> set[str]: ...

    def states(self) -> dict[str, str]: ...

    def focus(self, target: str) -> None: ...

    def focus_workspace(self, workspace_id: str) -> None: ...

    def turn(
        self,
        target: str,
        prompt: str,
        timeout_ms: int | None = None,
        cancel_event: threading.Event | None = None,
    ) -> tuple[str, str]: ...


@dataclass(frozen=True)
class Route:
    recipients: tuple[str, ...]
    body: str


@dataclass
class ReviewRound:
    id: str
    question: str
    reviewers: tuple[str, ...]
    synthesizer: str
    prompts: dict[str, str]
    question_seq: int | None
    states: dict[str, str]
    responses: dict[str, str] = field(default_factory=dict)
    cancel_event: threading.Event = field(default_factory=threading.Event, repr=False)
    lock: threading.RLock = field(default_factory=threading.RLock, repr=False)


def utc_now() -> str:
    return datetime.now(UTC).isoformat(timespec="seconds")


def parse_route(text: str, known_agents: Sequence[str]) -> Route:
    stripped = text.strip()
    if not stripped:
        raise ChatError("message is empty")
    match = MENTION_RE.match(stripped)
    if not match:
        if stripped.startswith("@"):
            raise ChatError("invalid mention syntax; use @name MESSAGE")
        return Route(tuple(known_agents), stripped)

    raw_recipients, body = match.groups()
    requested = [item.removeprefix("@").strip().lower() for item in raw_recipients.split(",")]
    if "all" in requested:
        recipients = list(known_agents)
    else:
        recipients = []
        for name in requested:
            if name not in known_agents:
                raise ChatError(f"unknown participant: @{name}")
            if name not in recipients:
                recipients.append(name)
    if not recipients:
        raise ChatError("no recipients selected")
    if not body.strip():
        raise ChatError("message is empty")
    return Route(tuple(recipients), body.strip())


class Transcript:
    def __init__(self, state_dir: Path, room: str) -> None:
        if not ROOM_RE.fullmatch(room):
            raise ChatError("room must match [a-z0-9][a-z0-9_-]{0,31}")
        self.state_dir = state_dir.expanduser()
        self.state_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(self.state_dir, 0o700)
        self.path = self.state_dir / f"{room}.jsonl"
        self.cursor_path = self.state_dir / f"{room}.state.json"
        self._lock = threading.RLock()
        self._render_cache: dict[int, tuple[tuple[int, int] | None, list[str]]] = {}

    def _stamp_unlocked(self) -> tuple[int, int] | None:
        try:
            stat = self.path.stat()
        except FileNotFoundError:
            return None
        return stat.st_mtime_ns, stat.st_size

    def read(self) -> list[dict[str, Any]]:
        with self._lock:
            return self._read_unlocked()

    def _read_unlocked(self) -> list[dict[str, Any]]:
        if not self.path.exists():
            return []
        messages: list[dict[str, Any]] = []
        for line_number, line in enumerate(
            self.path.read_text(encoding="utf-8").splitlines(), start=1
        ):
            if not line.strip():
                continue
            try:
                item = json.loads(line)
            except json.JSONDecodeError as error:
                raise ChatError(f"invalid transcript line {line_number}: {error}") from error
            if not isinstance(item, dict) or not isinstance(item.get("seq"), int):
                raise ChatError(f"invalid transcript line {line_number}")
            messages.append(item)
        return messages

    def append(
        self,
        sender: str,
        recipients: Iterable[str],
        body: str,
        *,
        kind: str = "message",
        round_id: str | None = None,
    ) -> dict[str, Any]:
        with self._lock:
            messages = self._read_unlocked()
            item = {
                "seq": (messages[-1]["seq"] + 1) if messages else 1,
                "at": utc_now(),
                "sender": sender,
                "recipients": list(recipients),
                "body": body.strip(),
                "kind": kind,
            }
            if round_id is not None:
                item["round_id"] = round_id
            with self.path.open("a", encoding="utf-8") as stream:
                stream.write(json.dumps(item, ensure_ascii=False, separators=(",", ":")) + "\n")
                stream.flush()
                os.fsync(stream.fileno())
            os.chmod(self.path, 0o600)
            self._render_cache.clear()
            return item

    def rendered_lines(self, width: int) -> list[str]:
        with self._lock:
            stamp = self._stamp_unlocked()
            cached = self._render_cache.get(width)
            if cached is not None and cached[0] == stamp:
                return cached[1]
            lines = message_lines(self._read_unlocked(), width)
            self._render_cache[width] = (stamp, lines)
            return lines

    def cursors(self) -> dict[str, int]:
        with self._lock:
            if not self.cursor_path.exists():
                return {}
            try:
                data = json.loads(self.cursor_path.read_text(encoding="utf-8"))
            except (json.JSONDecodeError, OSError) as error:
                raise ChatError(f"invalid room state: {error}") from error
            if not isinstance(data, dict) or not all(
                isinstance(key, str) and isinstance(value, int) for key, value in data.items()
            ):
                raise ChatError("invalid room state")
            return data

    def save_cursors(self, cursors: dict[str, int]) -> None:
        with self._lock:
            temporary = self.cursor_path.with_suffix(".tmp")
            temporary.write_text(
                json.dumps(cursors, sort_keys=True, separators=(",", ":")) + "\n",
                encoding="utf-8",
            )
            os.chmod(temporary, 0o600)
            temporary.replace(self.cursor_path)


class HerdrClient:
    def __init__(
        self,
        herdr_bin: str = "herdr",
        timeout_ms: int = 600_000,
        runner: Callable[..., subprocess.CompletedProcess[str]] = subprocess.run,
        popen_factory: Callable[..., subprocess.Popen[str]] | None = None,
    ) -> None:
        self.herdr_bin = herdr_bin
        self.timeout_ms = timeout_ms
        self.runner = runner
        self.popen_factory = (
            subprocess.Popen
            if popen_factory is None and runner is subprocess.run
            else popen_factory
        )

    def _run(self, arguments: list[str], timeout: float = 30) -> subprocess.CompletedProcess[str]:
        try:
            result = self.runner(
                [self.herdr_bin, *arguments],
                capture_output=True,
                text=True,
                errors="replace",
                timeout=timeout,
                check=False,
            )
        except OSError as error:
            raise CommandLaunchError(f"Herdr command failed: {error}") from error
        except subprocess.TimeoutExpired as error:
            raise ChatError(f"Herdr command failed: {error}") from error
        if result.returncode != 0:
            detail = result.stderr.strip() or result.stdout.strip() or "unknown error"
            raise ChatError(f"Herdr command failed: {detail}", code=herdr_error_code(detail))
        return result

    @staticmethod
    def _stop_process(process: subprocess.Popen[str]) -> None:
        process.terminate()
        try:
            process.communicate(timeout=1)
        except subprocess.TimeoutExpired:
            process.kill()
            process.communicate()

    def _run_interruptible(
        self,
        arguments: list[str],
        cancel_event: threading.Event | None,
        timeout: float,
    ) -> subprocess.CompletedProcess[str]:
        if self.popen_factory is None:
            return self._run(arguments, timeout=timeout)
        try:
            process = self.popen_factory(
                [self.herdr_bin, *arguments],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                errors="replace",
            )
        except OSError as error:
            raise CommandLaunchError(f"Herdr command failed: {error}") from error
        deadline = time.monotonic() + timeout
        while True:
            if cancel_event is not None and cancel_event.is_set():
                self._stop_process(process)
                raise ChatError("review cancelled")
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                self._stop_process(process)
                raise ChatError(f"Herdr command timed out after {int(timeout * 1000)} ms")
            try:
                stdout, stderr = process.communicate(timeout=min(0.1, remaining))
            except subprocess.TimeoutExpired:
                continue
            result = subprocess.CompletedProcess(
                [self.herdr_bin, *arguments], process.returncode, stdout, stderr
            )
            if result.returncode != 0:
                detail = result.stderr.strip() or result.stdout.strip() or "unknown error"
                raise ChatError(f"Herdr command failed: {detail}", code=herdr_error_code(detail))
            return result

    def _agents(self) -> list[dict[str, Any]]:
        result = self._run(["agent", "list"])
        try:
            payload = json.loads(result.stdout)
            agents = payload["result"]["agents"]
        except (json.JSONDecodeError, KeyError, TypeError) as error:
            raise ChatError("Herdr returned an invalid agent list") from error
        if not isinstance(agents, list):
            raise ChatError("Herdr returned an invalid agent list")
        return [item for item in agents if isinstance(item, dict)]

    def live_targets(self) -> set[str]:
        return {item["name"] for item in self._agents() if item.get("name")}

    def states(self) -> dict[str, str]:
        return {
            item["name"]: str(item.get("agent_status", "unknown"))
            for item in self._agents()
            if item.get("name")
        }

    def focus(self, target: str) -> None:
        result = self._run(["agent", "get", target])
        try:
            workspace_id = json.loads(result.stdout)["result"]["agent"]["workspace_id"]
        except (json.JSONDecodeError, KeyError, TypeError) as error:
            raise ChatError(f"Herdr returned invalid agent details for {target}") from error
        self._run(["workspace", "focus", workspace_id])
        self._run(["agent", "focus", target])

    def focus_workspace(self, workspace_id: str) -> None:
        self._run(["workspace", "focus", workspace_id])

    def turn(
        self,
        target: str,
        prompt: str,
        timeout_ms: int | None = None,
        cancel_event: threading.Event | None = None,
    ) -> tuple[str, str]:
        effective_timeout_ms = timeout_ms if timeout_ms is not None else self.timeout_ms
        token_match = REPLY_TOKEN_RE.search(prompt)
        if token_match is None:
            raise ChatError("relay prompt has no reply token")
        reply_marker_id = token_match.group(1)
        if cancel_event is not None and cancel_event.is_set():
            raise ChatError("review cancelled")

        submitted_at = time.monotonic()
        deadline = submitted_at + (effective_timeout_ms / 1000)
        try:
            self._submit_prompt(target, prompt, cancel_event, effective_timeout_ms)
        except ChatError as error:
            if error.code != "agent_blocked":
                self._raise_submission_failure(target, error)
            # Herdr rejects a blocked agent's prompt before any input is sent, so
            # the target is blocked, not working: never cancel here (an idle
            # Codex TUI treats Ctrl-C as quit). Startup polling is not the
            # correctness boundary for Codex's unreviewed-hooks notice — it can
            # render after every bounded window — so recover at submission: esc
            # it away, then retry the prompt exactly once.
            if cancel_event is not None and cancel_event.is_set():
                raise ChatError("review cancelled") from error
            if not self._dismiss_blocked_hooks_notice(target):
                return "blocked", ""
            try:
                self._submit_prompt(target, prompt, cancel_event, effective_timeout_ms)
            except ChatError as retry_error:
                if retry_error.code == "agent_blocked":
                    return "blocked", ""
                self._raise_submission_failure(target, retry_error)
            # The retry is a fresh submission; recovery time must not be charged
            # against the turn's observation window.
            submitted_at = time.monotonic()
            deadline = submitted_at + (effective_timeout_ms / 1000)
        saw_working = False
        stable_unmarked = 0
        last_unmarked_read: str | None = None
        last_status: str | None = None
        while True:
            if cancel_event is not None and cancel_event.is_set():
                self._cancel_if_working(target, last_status)
                raise ChatError("review cancelled")
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                self._cancel_if_working(target, self._agent_status(target))
                raise ChatError(f"Herdr command timed out after {effective_timeout_ms} ms")
            try:
                result = self._run(
                    ["agent", "get", target],
                    timeout=max(0.1, min(5, remaining)),
                )
            except ChatError:
                # The status is unknown exactly because this read failed, so the
                # cancel stays best-effort.
                self._cancel_if_working(target, None)
                raise
            try:
                agent_info = json.loads(result.stdout)["result"]["agent"]
                status = agent_info["agent_status"]
            except (json.JSONDecodeError, KeyError, TypeError) as error:
                self._cancel_if_working(target, None)
                raise ChatError(f"Herdr returned an invalid result for {target}") from error
            last_status = status
            if status == "blocked":
                return "blocked", ""
            if status == "working":
                saw_working = True
                stable_unmarked = 0
                last_unmarked_read = None
            elif status in {"idle", "done"} and (
                saw_working or time.monotonic() - submitted_at >= SUBMIT_GRACE_S
            ):
                # A verified Claude target with an exact session record gets
                # the clean transcript before any terminal capture, so TUI
                # artifacts (and refused or slow captures) cannot contaminate
                # the reply.
                reply = self._local_claude_reply(target, reply_marker_id, agent_info)
                if reply is not None:
                    return status, reply
                terminal = self._read_terminal(target, timeout=remaining)
                if terminal is None:
                    stable_unmarked = 0
                    last_unmarked_read = None
                else:
                    if HOOK_DIALOG_NEEDLE in terminal.lower():
                        return "blocked", ""
                    try:
                        return status, extract_reply(terminal, reply_marker_id)
                    except ChatError:
                        grok_reply = self._local_grok_reply(target, reply_marker_id)
                        if grok_reply is not None:
                            return status, grok_reply
                    if saw_working and terminal == last_unmarked_read:
                        stable_unmarked += 1
                    else:
                        stable_unmarked = 0
                    last_unmarked_read = terminal
                    if saw_working and stable_unmarked >= STABLE_UNMARKED_POLLS:
                        raise ChatError(
                            "reply markers HGCHAT_REPLY_* not found in "
                            f"@{target}'s completed response"
                        )
            pause = min(POLL_INTERVAL_S, max(0, remaining))
            if cancel_event is not None:
                cancel_event.wait(pause)
            else:
                time.sleep(pause)

    def _read_terminal(self, target: str, timeout: float) -> str | None:
        """Read recent terminal output, or None when Herdr refuses or the capture is slow.

        A refused read (Herdr's `agent_not_idle` at the idle->working flip) or a slow
        alternate-screen capture means the reply is not observable yet; the caller keeps
        polling until the token-bound reply appears or the turn deadline passes.
        """
        try:
            return self._run(
                ["agent", "read", target, "--source", "recent-unwrapped", "--lines", "240"],
                timeout=max(0.1, min(TERMINAL_READ_TIMEOUT_S, timeout)),
            ).stdout
        except ChatError:
            return None

    def _submit_prompt(
        self, target: str, prompt: str, cancel_event: threading.Event | None, timeout_ms: int
    ) -> None:
        self._run_interruptible(
            ["agent", "prompt", target, prompt],
            cancel_event,
            timeout=max(1, min(30, timeout_ms / 1000)),
        )

    def _raise_submission_failure(self, target: str, error: ChatError) -> NoReturn:
        if not isinstance(error, CommandLaunchError):
            # The prompt may still have landed, but no status is known here,
            # so this cancel stays best-effort.
            self._cancel_if_working(target, None)
        raise error

    def _read_visible(self, target: str) -> str:
        """Read the target's visible pane; a refused or slow read reads as blank.

        Recovery must fail closed: a terminal that cannot be observed is an
        unknown blocked dialog, never something to send keys to.
        """
        try:
            return self._run(
                ["agent", "read", target, "--source", "visible", "--lines", "80"],
                timeout=5,
            ).stdout
        except ChatError:
            return ""

    def _dismiss_blocked_hooks_notice(self, target: str) -> bool:
        """Dismiss the unreviewed Codex hooks notice with esc only, then report success.

        Called only after `agent prompt` was rejected with agent_blocked, so a
        dialog is holding the target and only that target is inspected. Each
        step observes fresh visible state: while the notice is on screen send
        esc — never t, enter, arrows, or Ctrl-C, so the hooks stay untrusted and
        no other dialog is answered — until a fresh read confirms it is gone.
        True means the notice was confirmed dismissed and the prompt may be
        retried; an unreadable or unrecognized dialog, or one surviving the esc
        budget, stays blocked untouched for the user to handle.
        """
        dismissed = False
        for _ in range(HOOK_RECOVERY_MAX_ESCS):
            if HOOK_DIALOG_NEEDLE not in self._read_visible(target).lower():
                return dismissed
            self._run(["agent", "send-keys", target, "esc"], timeout=5)
            dismissed = True
        return HOOK_DIALOG_NEEDLE not in self._read_visible(target).lower()

    def cancel(self, target: str) -> None:
        self._run(["agent", "send-keys", target, "ctrl+c"], timeout=5)

    def _agent_status(self, target: str) -> str | None:
        """Best-effort current agent status, or None when it cannot be determined."""
        try:
            result = self._run(["agent", "get", target], timeout=5)
            return str(json.loads(result.stdout)["result"]["agent"]["agent_status"])
        except (ChatError, json.JSONDecodeError, KeyError, TypeError):
            return None

    def _cancel_if_working(self, target: str, last_known_status: str | None) -> None:
        """Send Ctrl-C only to an agent believed to be working.

        An idle Codex TUI treats Ctrl-C as quit, which kills the participant
        process, so an agent last seen idle or done is left alone. When the
        status is genuinely unknown (the status read itself failed), the cancel
        stays best-effort as before.
        """
        if last_known_status is not None and last_known_status != "working":
            return
        with suppress(ChatError):
            self.cancel(target)

    def _local_claude_reply(
        self, target: str, token: str, agent: dict[str, Any] | None = None
    ) -> str | None:
        """Recover a Claude reply from its exact session transcript.

        Claude's TUI can render collapsed prompt-summary lines between the reply
        markers, so the clean session JSONL is preferred when Herdr's metadata
        names the exact session. Only that one derived path is read.
        """
        try:
            if agent is None:
                result = self._run(["agent", "get", target])
                agent = json.loads(result.stdout)["result"]["agent"]
            session = agent["agent_session"]
            if agent["agent"] != "claude" or session["source"] != "herdr:claude":
                return None
            session_id = str(session["value"])
            if not re.fullmatch(r"[0-9a-fA-F-]{8,64}", session_id):
                return None
            session_file = (
                Path.home()
                / ".claude"
                / "projects"
                / claude_project_dir_name(str(agent["cwd"]))
                / f"{session_id}.jsonl"
            )
            return extract_claude_session_reply(session_file, token)
        except (ChatError, KeyError, TypeError, json.JSONDecodeError, OSError):
            return None

    def _local_grok_reply(self, target: str, token: str) -> str | None:
        """Recover a Grok reply hidden above its alternate-screen viewport."""
        try:
            result = self._run(["agent", "get", target])
            agent = json.loads(result.stdout)["result"]["agent"]
            session = agent["agent_session"]
            if agent["agent"] != "grok" or session["source"] != "herdr:grok":
                return None
            session_dir = (
                Path.home() / ".grok" / "sessions" / quote(agent["cwd"], safe="") / session["value"]
            )
            return extract_grok_session_reply(session_dir, token)
        except (ChatError, KeyError, TypeError, json.JSONDecodeError, OSError):
            return None


def extract_reply(terminal: str, token: str) -> str:
    def wrapped_literal(value: str) -> re.Pattern[str]:
        compact = "".join(value.split())
        return re.compile(r"[ \t\r\n]*".join(re.escape(char) for char in compact))

    clean_terminal = TUI_TIMESTAMP_RE.sub(" ", terminal)
    start = wrapped_literal(f"HGCHAT_REPLY_BEGIN {token}")
    end = wrapped_literal(f"HGCHAT_REPLY_END {token}")
    start_matches = list(start.finditer(clean_terminal))
    if not start_matches:
        raise ChatError("agent response marker was not found")
    body_start = start_matches[-1].end()
    end_match = end.search(clean_terminal, body_start)
    if end_match is None:
        raise ChatError("agent response did not finish")
    body = clean_terminal[body_start : end_match.start()].strip()
    if not body:
        raise ChatError("agent returned an empty response")
    return body


def claude_project_dir_name(cwd: str) -> str:
    """Encode a working directory as a Claude Code project directory name.

    Claude Code keeps ASCII letters, digits, and hyphens and replaces every
    other path character (including `/`, `.`, `_`, and spaces) with `-`.
    """
    return re.sub(r"[^A-Za-z0-9-]", "-", cwd)


def extract_claude_session_reply(session_file: Path, token: str) -> str:
    """Extract the token-bound reply from Claude's exact session JSONL."""
    if not session_file.is_file():
        raise ChatError("Claude session transcript is unavailable")
    for line in reversed(session_file.read_text(encoding="utf-8", errors="replace").splitlines()):
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(record, dict) or record.get("type") != "assistant":
            continue
        message = record.get("message")
        if not isinstance(message, dict):
            continue
        content = message.get("content")
        blocks = content if isinstance(content, list) else [content]
        for block in blocks:
            if isinstance(block, dict) and isinstance(block.get("text"), str):
                try:
                    return extract_reply(block["text"], token)
                except ChatError:
                    continue
    raise ChatError("Claude session response marker was not found")


def extract_grok_session_reply(session_dir: Path, token: str) -> str:
    """Extract the token-bound reply from Grok's local active-session history."""
    history = session_dir / "chat_history.jsonl"
    if not history.is_file():
        raise ChatError("Grok session history is unavailable")
    for line in reversed(history.read_text(encoding="utf-8").splitlines()):
        try:
            item = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(item, dict):
            continue
        content = item.get("content")
        if item.get("type") != "assistant" or not isinstance(content, str):
            continue
        try:
            return extract_reply(content, token)
        except ChatError:
            continue
    raise ChatError("Grok session response marker was not found")


def format_context(messages: Sequence[dict[str, Any]]) -> str:
    if not messages:
        return "(No new group messages.)"
    return "\n\n".join(f"[{item['sender']}] {item['body']}" for item in messages)


def build_prompt(
    agent: str,
    messages: Sequence[dict[str, Any]],
    token: str,
    participants: Sequence[str],
    host: str = "Herdr",
) -> str:
    roster = ", ".join(["a human", *(f"@{name}" for name in participants)])
    return (
        f"You are @{agent}, a full participant in a local group chat with {roster}. "
        "Keep your normal capabilities and instructions. "
        "Respond to the room as yourself. Use your ordinary tools when the task requires "
        f"them, but do not use {host} to relay this reply because the group-chat relay handles "
        "delivery. Apply your own data-handling rules independently; another participant's "
        "eligibility never transfers to you. If the user invokes a bounded disclosure, "
        "verify your active provider, model, account-surface eligibility, exact payload, and "
        "purpose before reading. Avoid auxiliary index or shell probes when the exact "
        "named payload can be read directly. If eligible, begin the message with a non-secret "
        "ROUTE_RECEIPT naming that route; otherwise refuse before reading and name the "
        "missing condition.\n\n"
        "New room messages since your last delivered turn:\n\n"
        f"{format_context(messages)}\n\n"
        "Return one direct group-chat message. Wrap only that message between these marker "
        "lines:\n"
        f"HGCHAT_REPLY_BEGIN {token}\n"
        f"HGCHAT_REPLY_END {token}\n"
    )


def build_review_prompt(
    agent: str,
    question: str,
    token: str,
    participants: Sequence[str],
    host: str = "Herdr",
) -> str:
    roster = ", ".join(f"@{name}" for name in participants)
    return (
        f"You are @{agent}, one of the independent reviewers in a local {host} group chat "
        f"with {roster}. Keep your normal capabilities, instructions, and data-handling "
        "rules. Review the human's question independently. Do not assume or imitate another "
        "reviewer's answer; their answers are deliberately withheld until synthesis. Use your "
        f"ordinary tools when needed, but do not use {host} to relay this reply because the "
        "group-chat relay handles delivery.\n\n"
        "Question for independent review:\n\n"
        f"{question}\n\n"
        "Return one direct review message. Wrap only that message between these marker lines:\n"
        f"HGCHAT_REPLY_BEGIN {token}\n"
        f"HGCHAT_REPLY_END {token}\n"
    )


def build_synthesis_prompt(
    synthesizer: str,
    question: str,
    reviewers: Sequence[str],
    responses: dict[str, str],
    token: str,
    host: str = "Herdr",
) -> str:
    review_text = "\n\n".join(
        f"[@{name}] {responses.get(name, '(no usable response)')}" for name in reviewers
    )
    return (
        f"You are @{synthesizer}, the designated synthesizer in a local {host} group chat. "
        "Keep your normal capabilities, instructions, and data-handling rules. The reviewers "
        "answered independently. Identify agreements, material disagreements, and the best "
        "supported final recommendation. Do not claim consensus when the reviews differ. Use "
        f"your ordinary tools only if synthesis genuinely requires them, and do not use {host} "
        "to relay this reply because the group-chat relay handles delivery.\n\n"
        "Human question:\n\n"
        f"{question}\n\n"
        "Independent reviews:\n\n"
        f"{review_text}\n\n"
        "Return one direct synthesis message. Wrap only that message between these marker lines:\n"
        f"HGCHAT_REPLY_BEGIN {token}\n"
        f"HGCHAT_REPLY_END {token}\n"
    )


def failure_state(error: ChatError) -> str:
    detail = str(error).lower()
    return "timed_out" if "timeout" in detail or "timed out" in detail else "failed"


class GroupChat:
    def __init__(
        self,
        transcript: Transcript,
        agents: dict[str, str],
        client: AgentClient,
        max_turns: int = 4,
        agents_workspace_id: str | None = None,
        synthesizer: str = "pi",
        agent_timeouts: dict[str, int] | None = None,
        host_label: str = "Herdr",
    ) -> None:
        if max_turns < 1:
            raise ChatError("max turns must be positive")
        self.transcript = transcript
        self.agents = agents
        self.client = client
        self.max_turns = max_turns
        self.agents_workspace_id = agents_workspace_id
        if synthesizer not in agents:
            raise ChatError(f"unknown synthesizer: @{synthesizer}")
        duplicates = sorted(
            target for target in set(agents.values()) if list(agents.values()).count(target) > 1
        )
        if duplicates:
            raise ChatError(f"agent targets must be unique: {', '.join(duplicates)}")
        self.synthesizer = synthesizer
        self.agent_timeouts = dict(agent_timeouts or {})
        self.host_label = host_label

    def _ensure_live(self, names: Sequence[str]) -> None:
        targets = self.client.live_targets()
        missing = [name for name in names if self.agents[name] not in targets]
        if missing:
            labels = ", ".join(f"@{name}" for name in missing)
            raise ChatError(f"participant not live in {self.host_label}: {labels}")

    def _timeout_for(self, agent: str) -> int | None:
        return self.agent_timeouts.get(agent)

    @staticmethod
    def _set_review_state(
        review: ReviewRound,
        agent: str,
        state: str,
        on_state: Callable[[str, str], None] | None,
    ) -> None:
        with review.lock:
            review.states[agent] = state
        if on_state is not None:
            on_state(agent, state)

    @staticmethod
    def _begin_review_call(
        review: ReviewRound,
        agent: str,
        state: str,
        on_state: Callable[[str, str], None] | None,
    ) -> bool:
        with review.lock:
            if review.cancel_event.is_set():
                review.states[agent] = "cancelled"
                effective_state = "cancelled"
                should_start = False
            else:
                review.states[agent] = state
                effective_state = state
                should_start = True
        if on_state is not None:
            on_state(agent, effective_state)
        return should_start

    def dispatch(self, text: str) -> list[dict[str, Any]]:
        route = parse_route(text, tuple(self.agents))
        selected = route.recipients[: self.max_turns]
        self._ensure_live(selected)

        created = [self.transcript.append("human", selected, route.body)]
        cursors = self.transcript.cursors()
        for agent in selected:
            messages = [
                item
                for item in self.transcript.read()
                if item["seq"] > cursors.get(agent, 0) and item["sender"] != agent
            ]
            token = uuid.uuid4().hex
            prompt = build_prompt(agent, messages, token, tuple(self.agents), self.host_label)
            try:
                status, reply = self.client.turn(
                    self.agents[agent], prompt, self._timeout_for(agent)
                )
                if status == "blocked":
                    item = self.transcript.append(
                        "system",
                        ("human",),
                        f"@{agent} is blocked and needs attention in {self.host_label}.",
                    )
                else:
                    item = self.transcript.append(agent, ("human", "all"), reply)
            except ChatError as error:
                item = self.transcript.append("system", ("human",), f"@{agent}: {error}")
            created.append(item)
            if item["sender"] == agent:
                cursors[agent] = item["seq"]
            self.transcript.save_cursors(cursors)
        return created

    def plan_review(self, text: str) -> ReviewRound:
        route = parse_route(text, tuple(self.agents))
        reviewers = route.recipients[: self.max_turns]
        required = tuple(dict.fromkeys((*reviewers, self.synthesizer)))
        round_id = uuid.uuid4().hex
        prompts = {
            agent: build_review_prompt(
                agent,
                route.body,
                uuid.uuid4().hex,
                tuple(self.agents),
                self.host_label,
            )
            for agent in reviewers
        }
        return ReviewRound(
            id=round_id,
            question=route.body,
            reviewers=reviewers,
            synthesizer=self.synthesizer,
            prompts=prompts,
            question_seq=None,
            states={agent: "queued" for agent in required},
        )

    def _activate_review(self, review: ReviewRound) -> bool:
        required = tuple(dict.fromkeys((*review.reviewers, review.synthesizer)))
        self._ensure_live(required)
        with review.lock:
            if review.cancel_event.is_set():
                return False
            question_item = self.transcript.append(
                "human",
                review.reviewers,
                review.question,
                kind="review_question",
                round_id=review.id,
            )
            review.question_seq = question_item["seq"]
        return True

    def prepare_review(self, text: str) -> ReviewRound:
        review = self.plan_review(text)
        self._activate_review(review)
        return review

    def _run_reviewer(
        self,
        review: ReviewRound,
        agent: str,
        on_state: Callable[[str, str], None] | None,
    ) -> tuple[str, str]:
        if not self._begin_review_call(review, agent, "working", on_state):
            raise ChatError("review cancelled")
        return self.client.turn(
            self.agents[agent],
            review.prompts[agent],
            self._timeout_for(agent),
            review.cancel_event,
        )

    def _record_reviewer_result(
        self,
        review: ReviewRound,
        agent: str,
        future: Future[tuple[str, str]],
        on_state: Callable[[str, str], None] | None,
    ) -> None:
        if review.cancel_event.is_set() and future.exception() is not None:
            self._set_review_state(review, agent, "cancelled", on_state)
            return
        try:
            status, reply = future.result()
        except ChatError as error:
            state = failure_state(error)
            self._set_review_state(review, agent, state, on_state)
            self.transcript.append(
                "system",
                ("human",),
                f"@{agent} review {state.replace('_', ' ')}: {error}",
                kind="review_status",
                round_id=review.id,
            )
            return
        if status == "blocked":
            self._set_review_state(review, agent, "blocked", on_state)
            self.transcript.append(
                "system",
                ("human",),
                f"@{agent} is blocked and needs attention in {self.host_label}.",
                kind="review_status",
                round_id=review.id,
            )
            return
        self.transcript.append(
            agent,
            ("human", "all"),
            reply,
            kind="review_response",
            round_id=review.id,
        )
        with review.lock:
            review.responses[agent] = reply
        cursors = self.transcript.cursors()
        if review.question_seq is None:
            raise ChatError("review question is not active")
        cursors[agent] = review.question_seq
        self.transcript.save_cursors(cursors)
        self._set_review_state(review, agent, "done", on_state)

    def _synthesize_review(
        self,
        review: ReviewRound,
        on_state: Callable[[str, str], None] | None,
    ) -> None:
        if not self._begin_review_call(review, review.synthesizer, "synthesizing", on_state):
            return
        with review.lock:
            responses = dict(review.responses)
        if not responses:
            self._set_review_state(review, review.synthesizer, "skipped", on_state)
            self.transcript.append(
                "system",
                ("human",),
                "Review ended without a usable response; synthesis was skipped.",
                kind="review_status",
                round_id=review.id,
            )
            return
        token = uuid.uuid4().hex
        prompt = build_synthesis_prompt(
            review.synthesizer,
            review.question,
            review.reviewers,
            responses,
            token,
            self.host_label,
        )
        try:
            status, reply = self.client.turn(
                self.agents[review.synthesizer],
                prompt,
                self._timeout_for(review.synthesizer),
                review.cancel_event,
            )
        except ChatError as error:
            if review.cancel_event.is_set():
                self._set_review_state(review, review.synthesizer, "cancelled", on_state)
                return
            state = failure_state(error)
            self._set_review_state(review, review.synthesizer, state, on_state)
            self.transcript.append(
                "system",
                ("human",),
                f"@{review.synthesizer} synthesis {state.replace('_', ' ')}: {error}",
                kind="review_status",
                round_id=review.id,
            )
            return
        if review.cancel_event.is_set():
            self._set_review_state(review, review.synthesizer, "cancelled", on_state)
            return
        if status == "blocked":
            self._set_review_state(review, review.synthesizer, "blocked", on_state)
            self.transcript.append(
                "system",
                ("human",),
                f"@{review.synthesizer} synthesis is blocked and needs attention in "
                f"{self.host_label}.",
                kind="review_status",
                round_id=review.id,
            )
            return
        item = self.transcript.append(
            review.synthesizer,
            ("human", "all"),
            reply,
            kind="review_synthesis",
            round_id=review.id,
        )
        cursors = self.transcript.cursors()
        cursors[review.synthesizer] = item["seq"]
        self.transcript.save_cursors(cursors)
        self._set_review_state(review, review.synthesizer, "done", on_state)

    def execute_review(
        self,
        review: ReviewRound,
        on_state: Callable[[str, str], None] | None = None,
    ) -> ReviewRound:
        if review.question_seq is None and not self._activate_review(review):
            return review
        with ThreadPoolExecutor(
            max_workers=len(review.reviewers), thread_name_prefix="hgchat-review"
        ) as pool:
            futures = {
                pool.submit(self._run_reviewer, review, agent, on_state): agent
                for agent in review.reviewers
            }
            for future in as_completed(futures):
                self._record_reviewer_result(review, futures[future], future, on_state)
        if review.cancel_event.is_set():
            self.transcript.append(
                "system",
                ("human",),
                "Review cancelled; synthesis was not started.",
                kind="review_status",
                round_id=review.id,
            )
            return review
        self._synthesize_review(review, on_state)
        return review

    def review(
        self,
        text: str,
        on_state: Callable[[str, str], None] | None = None,
    ) -> ReviewRound:
        return self.execute_review(self.plan_review(text), on_state)

    def retry_review(
        self,
        review: ReviewRound,
        agent: str,
        on_state: Callable[[str, str], None] | None = None,
        *,
        reset_cancel: bool = True,
    ) -> ReviewRound:
        if agent not in review.reviewers:
            raise ChatError(f"@{agent} was not a reviewer in the last round")
        with review.lock:
            if review.question_seq is None:
                raise ChatError("the last review never started and cannot be retried")
            if agent in review.responses:
                raise ChatError(f"@{agent} already has a usable review response")
            if reset_cancel:
                review.cancel_event = threading.Event()
        self._ensure_live((agent, review.synthesizer))
        if review.cancel_event.is_set():
            return review
        review.prompts[agent] = build_review_prompt(
            agent,
            review.question,
            uuid.uuid4().hex,
            tuple(self.agents),
            self.host_label,
        )
        self._set_review_state(review, agent, "queued", on_state)
        with ThreadPoolExecutor(max_workers=1, thread_name_prefix="hgchat-retry") as pool:
            future = pool.submit(self._run_reviewer, review, agent, on_state)
            self._record_reviewer_result(review, agent, future, on_state)
        with review.lock:
            retry_succeeded = review.states[agent] == "done"
        if not review.cancel_event.is_set() and retry_succeeded:
            self._synthesize_review(review, on_state)
        return review

    def retry_synthesis(
        self,
        review: ReviewRound,
        on_state: Callable[[str, str], None] | None = None,
        *,
        reset_cancel: bool = True,
    ) -> ReviewRound:
        with review.lock:
            if review.question_seq is None:
                raise ChatError("the last review never started and cannot be retried")
            if reset_cancel:
                review.cancel_event = threading.Event()
        self._ensure_live((review.synthesizer,))
        if review.cancel_event.is_set():
            return review
        self._synthesize_review(review, on_state)
        return review

    def cancel_review(self, review: ReviewRound) -> None:
        with review.lock:
            review.cancel_event.set()
            for name, state in review.states.items():
                if state == "queued":
                    review.states[name] = "cancelled"


def parse_agent_overrides(values: Sequence[str]) -> dict[str, str]:
    agents = dict(DEFAULT_AGENTS)
    for value in values:
        if "=" not in value:
            raise ChatError("--agent must be NAME=HERDR_TARGET")
        name, target = value.split("=", 1)
        if name not in DEFAULT_AGENTS or not target:
            raise ChatError(f"invalid agent mapping: {value}")
        agents[name] = target
    return agents


def parse_agent_timeouts(values: Sequence[str], agents: Sequence[str]) -> dict[str, int]:
    timeouts: dict[str, int] = {}
    for value in values:
        if "=" not in value:
            raise ChatError("--agent-timeout must be NAME=MILLISECONDS")
        name, raw_timeout = value.split("=", 1)
        name = name.strip().lower()
        if name not in agents:
            raise ChatError(f"unknown participant in --agent-timeout: @{name}")
        try:
            timeout_ms = int(raw_timeout)
        except ValueError as error:
            raise ChatError(f"invalid timeout for @{name}: {raw_timeout}") from error
        if not 1_000 <= timeout_ms <= 3_600_000:
            raise ChatError(f"timeout for @{name} must be between 1000 and 3600000 ms")
        timeouts[name] = timeout_ms
    return timeouts


def resolve_state_dir(
    explicit: Path | None,
    environ: dict[str, str] | os._Environ[str] = os.environ,
) -> Path:
    if explicit is not None:
        return explicit
    plugin_state = environ.get("HERDR_PLUGIN_STATE_DIR", "").strip()
    if plugin_state:
        return Path(plugin_state)
    return DEFAULT_STATE_DIR


def message_lines(messages: Sequence[dict[str, Any]], width: int) -> list[str]:
    lines: list[str] = []
    for item in messages:
        label = str(item["sender"])
        if item.get("kind") == "review_response":
            label += " [review]"
        elif item.get("kind") == "review_synthesis":
            label += " [synthesis]"
        prefix = f"{label}> "
        paragraphs = str(item["body"]).splitlines() or [""]
        first = True
        for paragraph in paragraphs:
            wrapped = textwrap.wrap(
                paragraph,
                width=max(10, width - len(prefix)),
                replace_whitespace=False,
                drop_whitespace=True,
            ) or [""]
            for line in wrapped:
                lines.append((prefix if first else " " * len(prefix)) + line)
                first = False
        lines.append("")
    return lines


def inbox_messages(messages: Sequence[dict[str, Any]]) -> list[dict[str, Any]]:
    """Project the transcript onto a presentation-only inbox.

    Keeps final agent replies, review syntheses, system notices, and only those
    review statuses that demand attention. Drops human turns, review questions,
    independent review drafts, and quiet review statuses.
    """
    attention_markers = ("blocked", "failed", "timed out", "cancelled")
    kept: list[dict[str, Any]] = []
    for item in messages:
        sender = item.get("sender")
        kind = item.get("kind")
        if sender == "human":
            continue
        if kind == "review_synthesis":
            kept.append(item)
        elif kind == "review_status":
            body = str(item.get("body", "")).lower()
            if any(marker in body for marker in attention_markers):
                kept.append(item)
        elif kind == "message":
            kept.append(item)
    return kept


def inbox_rendered_lines(messages: Sequence[dict[str, Any]], width: int) -> list[str]:
    if not messages:
        return ["Inbox is clear. Final replies and items needing attention appear here."]
    return message_lines(messages, width)


def handle_view_command(text: str) -> tuple[str, str] | None:
    """Handle the exact /inbox and /room view switches; anything else is None."""
    stripped = text.strip()
    if stripped == "/inbox":
        return (
            "inbox",
            "Inbox shows final replies, syntheses, and attention items. Use /room to return.",
        )
    if stripped == "/room":
        return "room", "Showing the full room transcript."
    return None


def visible_message_lines(
    messages: Sequence[dict[str, Any]],
    width: int,
    available: int,
    scroll_offset: int,
) -> tuple[list[str], int]:
    return visible_wrapped_lines(message_lines(messages, width), available, scroll_offset)


def visible_wrapped_lines(
    lines: Sequence[str], available: int, scroll_offset: int
) -> tuple[list[str], int]:
    max_offset = max(0, len(lines) - available)
    offset = min(max(0, scroll_offset), max_offset)
    end = len(lines) - offset
    start = max(0, end - available)
    return lines[start:end], max_offset


class ReviewController:
    def __init__(self, chat: GroupChat) -> None:
        self.chat = chat
        self._lock = threading.RLock()
        self._active: ReviewRound | None = None
        self._last: ReviewRound | None = None
        self._thread: threading.Thread | None = None
        self._states: dict[str, str] = {}
        self._notice = ""

    def _on_state(self, agent: str, state: str) -> None:
        with self._lock:
            self._states[agent] = state

    def _run(self, action: Callable[[], ReviewRound], review: ReviewRound) -> None:
        try:
            action()
        except ChatError as error:
            notice = f"Review failed: {error}"
        except Exception as error:
            notice = f"Review failed unexpectedly: {error}"
        else:
            notice = "Review cancelled." if review.cancel_event.is_set() else "Review complete."
        with self._lock:
            self._last = review
            self._active = None
            self._notice = notice

    def _launch(self, action: Callable[[], ReviewRound], review: ReviewRound) -> None:
        self._active = review
        with review.lock:
            self._states = dict(review.states)
        self._notice = ""
        self._thread = threading.Thread(
            target=self._run,
            args=(action, review),
            name="hgchat-review-controller",
            daemon=True,
        )
        self._thread.start()

    def start(self, text: str) -> str:
        with self._lock:
            if self._active is not None:
                raise ChatError("a review is already running")
            review = self.chat.plan_review(text)
            self._launch(lambda: self.chat.execute_review(review, self._on_state), review)
        reviewers = ", @".join(review.reviewers)
        return f"Review started with @{reviewers}; @{review.synthesizer} synthesizes."

    def retry(self, target: str) -> str:
        name = target.removeprefix("@").strip().lower()
        with self._lock:
            if self._active is not None:
                raise ChatError("wait for the active review or cancel it before retrying")
            if self._last is None:
                raise ChatError("there is no review to retry")
            review = self._last
            with review.lock:
                if review.question_seq is None:
                    raise ChatError("the last review never started and cannot be retried")
                if name != "synthesis" and name not in review.reviewers:
                    raise ChatError(f"@{name} was not a reviewer in the last round")
                if name in review.responses:
                    raise ChatError(f"@{name} already has a usable review response")
                review.cancel_event = threading.Event()
            if name == "synthesis":

                def action() -> ReviewRound:
                    return self.chat.retry_synthesis(review, self._on_state, reset_cancel=False)

                label = "synthesis"
            else:

                def action() -> ReviewRound:
                    return self.chat.retry_review(review, name, self._on_state, reset_cancel=False)

                label = f"@{name}"
            self._launch(action, review)
        return f"Retrying {label}."

    def cancel(self) -> str:
        with self._lock:
            if self._active is None:
                raise ChatError("there is no active review to cancel")
            review = self._active
        self.chat.cancel_review(review)
        with review.lock, self._lock:
            self._states = dict(review.states)
        return "Cancellation requested."

    def is_active(self) -> bool:
        with self._lock:
            return self._active is not None

    def status(self) -> str:
        with self._lock:
            if self._active is None:
                return self._notice
            review = self._active
            order = tuple(dict.fromkeys((*review.reviewers, review.synthesizer)))
            labels = [f"@{name} {self._states.get(name, 'queued')}" for name in order]
        return "Review: " + " · ".join(labels)

    def clear_notice(self) -> None:
        with self._lock:
            if self._active is None:
                self._notice = ""

    def wait(self, timeout: float = 5) -> bool:
        with self._lock:
            thread = self._thread
        if thread is None:
            return True
        thread.join(timeout)
        return not thread.is_alive()


def participant_status(chat: GroupChat, prefix: str = "") -> str:
    try:
        target_states = chat.client.states()
    except ChatError:
        target_states = {}
    labels = []
    for name, target in chat.agents.items():
        state = target_states.get(target, "offline")
        if state in {"idle", "done"}:
            state = "ready"
        labels.append(f"@{name} {state}")
    summary = " · ".join(labels)
    return f"{prefix} {summary}".strip()


def handle_local_command(
    text: str, chat: GroupChat, reviews: ReviewController | None = None
) -> str | None:
    stripped = text.strip()
    if not stripped.startswith("/"):
        return None
    if stripped == "/agents":
        if not chat.agents_workspace_id:
            return "The agents workspace is unavailable; use /show <agent>."
        chat.client.focus_workspace(chat.agents_workspace_id)
        return "Focused the agents workspace."
    if stripped == "/help":
        return (
            "Commands: /review [@agents] QUESTION · /retry <agent|synthesis> · "
            "/cancel · /agents · /show <agent> · /inbox · /room · PgUp/PgDn"
        )
    if stripped == "/review" or stripped.startswith("/review "):
        if reviews is None:
            return "Review control is unavailable."
        question = stripped.removeprefix("/review").strip()
        if not question:
            return "Usage: /review [@agent,@agent] QUESTION"
        return reviews.start(question)
    if stripped == "/cancel":
        if reviews is None:
            return "Review control is unavailable."
        return reviews.cancel()
    if stripped.startswith("/retry "):
        if reviews is None:
            return "Review control is unavailable."
        target = stripped.removeprefix("/retry ").strip()
        if not target:
            return "Usage: /retry <agent|synthesis>"
        return reviews.retry(target)
    if stripped.startswith("/show "):
        name = stripped.removeprefix("/show ").strip().lower()
        if name not in chat.agents:
            return f"Unknown participant: {name}"
        chat.client.focus(chat.agents[name])
        return f"Focused @{name}."
    return "Unknown command. Use /help."


def draw_tui(
    screen: curses.window,
    transcript: Transcript,
    room: str,
    buffer: str,
    status: str,
    participants: Sequence[str],
    scroll_offset: int = 0,
    title: str = "Herdr group chat",
    view: str = "room",
) -> int:
    screen.erase()
    height, width = screen.getmaxyx()
    mentions = " ".join(f"@{name}" for name in participants)
    title = title if view == "room" else f"{title} | inbox (/room returns)"
    header = f" {title}: {room} | {mentions} @all | Ctrl-Q exits "
    try:
        screen.addnstr(0, 0, header, width - 1, curses.A_REVERSE)
        available = max(1, height - 4)
        if view == "inbox":
            all_lines = inbox_rendered_lines(inbox_messages(transcript.read()), width - 2)
        else:
            all_lines = transcript.rendered_lines(width - 2)
        lines, max_scroll = visible_wrapped_lines(all_lines, available, scroll_offset)
        for row, line in enumerate(lines, start=1):
            screen.addnstr(row, 1, line, width - 2)
        screen.addnstr(height - 3, 0, status, width - 1, curses.A_DIM)
        prompt = f"> {buffer}"
        screen.addnstr(height - 2, 0, prompt, width - 1)
        screen.move(height - 2, min(width - 1, len(prompt)))
    except curses.error:
        max_scroll = 0
    screen.refresh()
    return max_scroll


def run_tui(screen: curses.window, chat: GroupChat, room: str) -> None:
    curses.curs_set(1)
    screen.keypad(True)
    screen.timeout(100)
    buffer = ""
    scroll_offset = 0
    participants = tuple(chat.agents)
    reviews = ReviewController(chat)
    view = "room"
    status = participant_status(chat, "Ready.")
    status_override = False
    while True:
        review_status = reviews.status()
        max_scroll = draw_tui(
            screen,
            chat.transcript,
            room,
            buffer,
            status if status_override else (review_status or status),
            participants,
            scroll_offset,
            title=f"{chat.host_label} group chat",
            view=view,
        )
        try:
            key = screen.get_wch()
        except curses.error:
            continue
        if key in ("\x03", "\x11"):
            if reviews.is_active():
                with suppress(ChatError):
                    reviews.cancel()
                # The workers send Ctrl-C to their agents on their next poll tick; exiting
                # before that kills the daemon threads and leaves the agents working.
                reviews.wait(5)
            return
        if key == curses.KEY_PPAGE:
            scroll_offset = min(max_scroll, scroll_offset + max(1, screen.getmaxyx()[0] - 5))
            continue
        if key == curses.KEY_NPAGE:
            scroll_offset = max(0, scroll_offset - max(1, screen.getmaxyx()[0] - 5))
            continue
        if key in ("\n", "\r"):
            if not buffer.strip():
                continue
            reviews.clear_notice()
            status_override = False
            view_result = handle_view_command(buffer)
            if view_result is not None:
                view, status = view_result
                status_override = not reviews.is_active()
                scroll_offset = 0
                buffer = ""
                continue
            try:
                command_status = handle_local_command(buffer, chat, reviews)
            except ChatError as error:
                command_status = str(error)
                status_override = True
            if command_status is not None:
                status = command_status
                status_override = status_override or not reviews.is_active()
                buffer = ""
                continue
            if reviews.is_active():
                status = "A review is running; use /cancel or wait before sending another message."
                status_override = True
                buffer = ""
                continue
            status = "Waiting for the addressed agents..."
            draw_tui(
                screen,
                chat.transcript,
                room,
                "",
                status,
                participants,
                title=f"{chat.host_label} group chat",
                view=view,
            )
            try:
                chat.dispatch(buffer)
                status = participant_status(chat, "Delivered.")
            except ChatError as error:
                status = str(error)
            status_override = True
            buffer = ""
            scroll_offset = 0
            continue
        if key in (curses.KEY_BACKSPACE, "\x7f", "\b"):
            buffer = buffer[:-1]
            continue
        if isinstance(key, str) and key.isprintable():
            buffer += key


def record_setup_failures(transcript: Transcript) -> None:
    """Record launch-time participant setup failures as system entries.

    The setup pane hands them over via SETUP_FAILURES_ENV before exec'ing the
    room, because its own prints are lost when the room redraws the pane.
    """
    reported = os.environ.get(SETUP_FAILURES_ENV, "")
    for failure in reported.splitlines():
        if failure.strip():
            transcript.append("system", ("human",), f"setup: {failure.strip()}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--room", default=os.environ.get(ROOM_ENV, "cockpit"))
    parser.add_argument("--state-dir", type=Path)
    parser.add_argument("--max-turns", type=int, default=4)
    parser.add_argument("--timeout-ms", type=int, default=600_000)
    parser.add_argument("--agent", action="append", default=[], metavar="NAME=TARGET")
    parser.add_argument(
        "--agent-timeout",
        action="append",
        default=[],
        metavar="NAME=MILLISECONDS",
    )
    parser.add_argument(
        "--synthesizer",
        default=os.environ.get("HERDR_GROUP_CHAT_SYNTHESIZER", "pi"),
    )
    parser.add_argument("--agents-workspace", default=os.environ.get(AGENTS_WORKSPACE_ENV))
    parser.add_argument("--once", metavar="MESSAGE")
    parser.add_argument("--show", action="store_true")
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        transcript = Transcript(resolve_state_dir(args.state_dir), args.room)
        if args.show:
            for line in message_lines(transcript.read(), 100):
                print(line)
            return 0
        agents = parse_agent_overrides(args.agent)
        agent_timeouts = parse_agent_timeouts(args.agent_timeout, tuple(agents))
        chat = GroupChat(
            transcript,
            agents,
            HerdrClient(
                herdr_bin=os.environ.get("HERDR_BIN_PATH", "herdr"),
                timeout_ms=args.timeout_ms,
            ),
            max_turns=args.max_turns,
            agents_workspace_id=args.agents_workspace,
            synthesizer=args.synthesizer,
            agent_timeouts=agent_timeouts,
        )
        record_setup_failures(transcript)
        if args.once is not None:
            before = len(transcript.read())
            if args.once.strip() == "/review" or args.once.strip().startswith("/review "):
                question = args.once.strip().removeprefix("/review").strip()
                if not question:
                    raise ChatError("usage: --once '/review [@agents] QUESTION'")
                chat.review(question)
                created = transcript.read()[before:]
            else:
                created = chat.dispatch(args.once)
            for item in created:
                print(f"{item['sender']}> {item['body']}")
            return 0
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            raise ChatError("interactive mode requires a TTY; use --once or --show")
        curses.wrapper(run_tui, chat, args.room)
        return 0
    except ChatError as error:
        print(f"herdr-group-chat: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
