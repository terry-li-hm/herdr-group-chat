    reopen_pane_proofs: tuple[tuple[tuple[str, ...], ...], ...] = ()
    reopen_process_argv0: str = ""
    reopen_process_args: tuple[str, ...] = ()
    catalog_command: tuple[str, ...] = ()
    provider: str | None = None
    model: str = ""
    effort: str = ""
    # Optional PATH prefix expanded into this participant's tab environment
    # only; never the launcher's or any other participant's environment.
    tab_path_prefix: str = ""


