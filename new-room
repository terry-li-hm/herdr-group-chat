def clear_topology(state: dict[str, Any]) -> None:
    for field in TOPOLOGY_FIELDS:
        state.pop(field, None)


def load_validated_launcher_state(
    state_dir: Path, herdr_bin: str, state_path: Path | None = None
) -> dict[str, Any]:
    state = load_launcher_state(state_dir, state_path)
    pane_id = state.get("room_pane_id")
    if not pane_id:
        return state
    # Validate the recorded room with the read-only `pane get` inspection only:
    # focusing the pane merely to validate it would steal the caller's focus on
    # every subsequent launch once a room pane exists.
    try:
        response = run_json(herdr_bin, ["pane", "get", pane_id])
    except BootstrapError as error:
        if error.code == "pane_not_found":
            state.pop("room_pane_id", None)
            state.pop("room_tab_id", None)
            return state
        raise
    try:
        pane = response["result"]["pane"]
        matches = (
            str(pane["pane_id"]) == pane_id
            and str(pane["workspace_id"]) == state.get("chat_workspace_id")
            and str(pane["tab_id"]) == state.get("room_tab_id")
        )
    except (KeyError, TypeError):
        matches = False
    if not matches:
        clear_topology(state)
    return state


def workspaces(herdr_bin: str) -> list[dict[str, Any]]:
    listed = run_json(herdr_bin, ["workspace", "list"])
    return [
        workspace
        for workspace in listed.get("result", {}).get("workspaces", [])
        if isinstance(workspace, dict) and workspace.get("workspace_id")
    ]


def workspace_ids(herdr_bin: str) -> set[str]:
    return {str(workspace["workspace_id"]) for workspace in workspaces(herdr_bin)}


def new_room_id() -> str:
    timestamp = datetime.now(UTC).strftime("%Y%m%d-%H%M%S")
    return f"chat-{timestamp}-{uuid.uuid4().hex[:6]}"


def wait_for_shell(herdr_bin: str, pane_id: str, timeout: float = 10) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        payload = run_json(herdr_bin, ["pane", "process-info", "--pane", pane_id])
        processes = (
            payload.get("result", {}).get("process_info", {}).get("foreground_processes", [])
        )
        if len(processes) == 1 and processes[0].get("name") in {
            "bash",
            "fish",
            "nu",
            "sh",
            "zsh",
        }:
            return
        time.sleep(0.1)
    raise BootstrapError("new tab did not reach an interactive shell")


HOOK_DIALOG_NEEDLE = "trust all"
HOOK_MENU_NEEDLE = "continue without trusting"
HOOK_DISMISS_ATTEMPTS = 10
HOOK_DISMISS_INTERVAL_S = 1.0
HOOK_DISMISS_TIMEOUT_S = 5.0


def dismiss_inactive_hook_notice(herdr_bin: str, name: str, pane_id: str) -> None:
    """Dismiss Codex's hooks dialog without trusting hooks the user has not reviewed.

    The dialog can render after `agent start` reports ready, and the visible-pane
    read clips lines at viewport width, so detection retries briefly and matches
    short case-insensitive needles that survive clipping. Herdr's `pane read`
    emits raw terminal text rather than a JSON envelope, so the screen is read
    through the raw-text command helper. Hooks stay inactive: the summary notice
    is closed with esc, and the menu variant is answered with
    "Continue without trusting". Every pane read, retry sleep, and key send
    draws on one monotonic deadline, so slow-but-successful reads cannot hold
    the launcher lock for minutes; an expired deadline returns quietly with
    the notice left untrusted.
    """
    deadline = time.monotonic() + HOOK_DISMISS_TIMEOUT_S
    for attempt in range(HOOK_DISMISS_ATTEMPTS):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return
        text = run_text(
            herdr_bin,
            ["pane", "read", pane_id, "--source", "visible", "--lines", "80"],
            timeout=remaining,
        )
        lowered = text.lower()
        if HOOK_DIALOG_NEEDLE not in lowered:
            if attempt + 1 < HOOK_DISMISS_ATTEMPTS:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return
                time.sleep(min(HOOK_DISMISS_INTERVAL_S, remaining))
            continue
        keys = ("down", "down", "enter") if HOOK_MENU_NEEDLE in lowered else ("esc",)
        for key in keys:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return
            run_json(herdr_bin, ["agent", "send-keys", name, key], timeout=remaining)
        print("notice @codex unreviewed hooks left inactive", flush=True)
        return


AGENT_START_BUSY_ATTEMPTS = 5
AGENT_START_BUSY_INTERVAL_S = 2.0

VERIFY_PANE_ATTEMPTS = 15
VERIFY_PANE_INTERVAL_S = 1.0


def native_catalog_row_present(command: Sequence[str], provider: str, model: str) -> bool:
    """Require the model's exact catalog rows to name only its expected provider."""
    try:
        result = subprocess.run(
            list(command), capture_output=True, text=True, errors="replace", timeout=30
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    if result.returncode != 0:
        return False
    providers = {
        tokens[0]
        for line in result.stdout.splitlines()
        if len(tokens := line.split()) >= 2 and tokens[1] == model
    }
    return providers == {provider}


def catalog_proof(participant: Participant) -> bool:
    """Catalog preflight; must pass before any participant tab is created or started."""
    return not participant.catalog_command or (
        participant.provider is not None
        and native_catalog_row_present(
            participant.catalog_command, participant.provider, participant.model
        )
    )


def native_pane_process_proves(
    herdr_bin: str, pane_id: str, argv0: str, expected_args: Sequence[str]
) -> bool:
    """Exact native foreground-process evidence from `pane process-info`.

    A process matches only when its argv0 is exactly the expected executable
    identity and its argv contains the expected arguments as one contiguous
    sequence; an MCP child process, a lookalike model string, or reordered
    arguments never satisfy the proof.
    """
    expected = list(expected_args)

    def matches(process: object) -> bool:
        if not isinstance(process, dict):
            return False
        argv = [str(argument) for argument in process.get("argv", [])]
        # Herdr 0.8.2 reported the executable identity as ``argv0``; the
        # protocol-21 server reports ``name`` instead. Accept either, then
        # fall back to argv[0], and require an exact identity in every case.
        identity = str(process.get("argv0") or process.get("name") or (argv[0] if argv else ""))
        if identity != argv0:
            return False
        return any(
            list(argv[position : position + len(expected)]) == expected
            for position in range(len(argv) - len(expected) + 1)
        )

    for attempt in range(VERIFY_PANE_ATTEMPTS):
        payload = run_json(herdr_bin, ["pane", "process-info", "--pane", pane_id])
        processes = (
            payload.get("result", {}).get("process_info", {}).get("foreground_processes", [])
        )
        if any(matches(process) for process in processes):
            return True
        if attempt + 1 < VERIFY_PANE_ATTEMPTS:
            time.sleep(VERIFY_PANE_INTERVAL_S)
    return False


def participant_process_proves(herdr_bin: str, participant: Participant, pane_id: str) -> bool:
    """The only post-start native proof: the participant's own foreground process.

    A participant without start arguments is never process-proofed. Otherwise
    the proof is `pane process-info` on the agent's live pane: the foreground
    process's executable identity must be exactly the participant's kind (the
    canonical executable Herdr starts for that kind) and its argv must contain
    the start arguments as one contiguous sequence. Screen text is never
    evidence, so a model rename in a vendor UI cannot break a launch.
    """
    if not participant.start_args:
        return True
    return native_pane_process_proves(herdr_bin, pane_id, participant.kind, participant.start_args)


def live_agent_kind_matches(live_agent: Mapping[str, Any], expected_kind: str) -> bool:
    """Require every reported native-agent identity to match the participant kind."""
    reported = [
        str(live_agent[field]) for field in ("kind", "agent") if live_agent.get(field) is not None
    ]
    return bool(reported) and all(kind == expected_kind for kind in reported)


def needs_native_proof(participant: Participant) -> bool:
    return bool(participant.catalog_command or participant.start_args)


def profile_receipt_payload(profile: str, participants: Sequence[Participant]) -> dict[str, Any]:
    """Deterministic receipt payload carrying the profile's canonical evidence."""

    def entry(participant: Participant) -> dict[str, str]:
        verified = {
            "role": participant.role,
            "target": participant.name,
            "harness": participant.kind,
            "model": participant.model,
            "effort": participant.effort,
            "verification": "native-ui verified",
        }
        if participant.provider:
            verified["provider"] = participant.provider
        return verified

    return {
        "profile": profile,
        "verified": sorted((entry(p) for p in participants), key=lambda e: e["role"]),
    }


def profile_room_exec(profile: str, participants: Sequence[Participant]) -> tuple[list[str], str]:
    """Room argv and receipt payload shared by fresh launch and reopen."""
    arguments = ["--profile", profile]
    for participant in participants:
        arguments.extend(["--agent", f"{participant.role}={participant.name}"])
    arguments.extend(["--synthesizer", participants[0].role])
    receipt = json.dumps(
        profile_receipt_payload(profile, participants), sort_keys=True, separators=(",", ":")
    )
    return arguments, receipt


def participant_tab_env(participant: Participant) -> list[str]:
    """Tab-create env arguments; set only when a participant needs a PATH prefix."""
    if not participant.tab_path_prefix:
        return []
    prefix = str(Path(participant.tab_path_prefix).expanduser())
    parent = os.environ.get("PATH", "")
    # No trailing separator: an empty PATH component would resolve the cwd.
    combined = f"{prefix}{os.pathsep}{parent}" if parent else prefix
    return ["--env", f"PATH={combined}"]


def start_agent(
    herdr_bin: str, name: str, kind: str, pane_id: str, start_args: Sequence[str] = ()
) -> None:
    """Start an agent, retrying herdr's transient agent_pane_busy refusal.

    Native agent arguments are accepted only after a literal `--` pass-through
    separator, added exactly once and only when native arguments exist.
    """
    native_arguments = ["--", *start_args] if start_args else []
    for attempt in range(AGENT_START_BUSY_ATTEMPTS):
        try:
            run_json(
                herdr_bin,
                [
                    "agent",
                    "start",
                    name,
                    "--kind",
                    kind,
                    "--pane",
                    pane_id,
                    "--timeout",
                    "120000",
                    *native_arguments,
                ],
                timeout=None,
            )
            return
        except BootstrapError as error:
            if error.code != "agent_pane_busy" or attempt + 1 == AGENT_START_BUSY_ATTEMPTS:
                raise
            time.sleep(AGENT_START_BUSY_INTERVAL_S)


def ensure_owned_workspace(
    herdr_bin: str,
    cwd: str,
    state_dir: Path,
    state: dict[str, Any],
    state_path: Path,
    *,
    workspace_field: str,
    placeholder_field: str,
    pending_label_field: str,
    display_label: str,
) -> tuple[str, str | None]:
    listed = workspaces(herdr_bin)
    existing = state.get(workspace_field)
    matched = next(
        (workspace for workspace in listed if str(workspace["workspace_id"]) == existing),
        None,
    )
    if matched is None:
        pending_label = state.get(pending_label_field)
        if not pending_label:
            pending_label = f"hgchat-{display_label}-{uuid.uuid4().hex[:10]}"
            state[pending_label_field] = pending_label
            save_launcher_state(state_dir, state, state_path)
        matched = next(
            (workspace for workspace in listed if workspace.get("label") == pending_label),
            None,
        )
        if matched is None:
            assert_server_identity(state_dir, state_path)
            created = run_json(
                herdr_bin,
                [
                    "workspace",
                    "create",
                    "--cwd",
                    cwd,
                    "--label",
                    pending_label,
                    "--no-focus",
                ],
                timeout=None,
            )
            workspace_id = str(created["result"]["workspace"]["workspace_id"])
            placeholder_tab_id = str(created["result"]["tab"]["tab_id"])
        else:
            workspace_id = str(matched["workspace_id"])
            placeholder_tab_id = str(matched["active_tab_id"])
        state[workspace_field] = workspace_id
        state[placeholder_field] = placeholder_tab_id
        state.pop(pending_label_field, None)
        save_launcher_state(state_dir, state, state_path)
    else:
        workspace_id = str(matched["workspace_id"])
        placeholder_tab_id = state.get(placeholder_field)
    if matched is None or matched.get("label") != display_label:
        assert_server_identity(state_dir, state_path)
        run_json(
            herdr_bin,
            ["workspace", "rename", workspace_id, display_label],
            timeout=None,
        )
    return workspace_id, placeholder_tab_id


def ensure_agents_workspace(
