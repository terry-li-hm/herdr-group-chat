def resolve_profile(profile: str | None) -> tuple[Participant, ...]:
    """Resolve a profile name to its exact participants; unknown names fail closed."""
    if profile is None or profile == "":
        return tuple(Participant(role=kind, kind=kind, name=name) for kind, name in PARTICIPANTS)
    participants = PROFILE_PARTICIPANTS.get(profile)
    if participants is None:
        raise BootstrapError(f"unknown profile: {profile}", code="unknown_profile")
    return participants


class BootstrapError(RuntimeError):
    """A user-visible setup failure."""

    def __init__(
        self, message: str, code: str | None = None, failures: Sequence[str] | None = None
    ) -> None:
        super().__init__(message)
        self.code = code
        # Optional per-role reasons carried into the durable launcher record.
        self.failures = list(failures) if failures else None


def _run_herdr(
    herdr_bin: str, arguments: list[str], timeout: float | None = 30
) -> subprocess.CompletedProcess[str]:
    try:
        result = subprocess.run(
            [herdr_bin, *arguments],
            capture_output=True,
            text=True,
            errors="replace",
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired as error:
        raise BootstrapError(f"Herdr command timed out: {error}", code="command_timeout") from error
    except OSError as error:
        raise BootstrapError(
            f"Herdr command failed: {error}", code="command_spawn_failed"
        ) from error
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "unknown Herdr error"
        code = None
        with suppress(json.JSONDecodeError, KeyError, TypeError):
            code = str(json.loads(detail)["error"]["code"])
        raise BootstrapError(detail, code=code)
    return result


def run_json(herdr_bin: str, arguments: list[str], timeout: float | None = 30) -> dict[str, Any]:
    result = _run_herdr(herdr_bin, arguments, timeout)
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise BootstrapError("Herdr returned invalid JSON") from error
    if not isinstance(payload, dict):
        raise BootstrapError("Herdr returned an invalid response")
    return payload


def run_text(herdr_bin: str, arguments: list[str], timeout: float | None = 30) -> str:
    """Run a Herdr command whose stdout is raw terminal text, not a JSON envelope."""
    return _run_herdr(herdr_bin, arguments, timeout).stdout


def plugin_state_dir() -> Path:
    configured = os.environ.get("HERDR_PLUGIN_STATE_DIR", "").strip()
    if configured:
        return Path(configured).expanduser()
    return Path("~/.local/state/herdr-group-chat").expanduser()


def launcher_errors_path() -> Path:
    return plugin_state_dir() / LAUNCHER_ERRORS_NAME


def _launcher_error_record(
    mode: str, arguments: Sequence[str], error: BaseException
) -> dict[str, Any]:
    """Build one failure record: the launch facts plus non-secret Herdr context."""
    context = plugin_context()
    configured_state_dir = os.environ.get("HERDR_PLUGIN_STATE_DIR", "").strip()
    carried_failures = getattr(error, "failures", None)
    record: dict[str, Any] = {
        "at": datetime.now(UTC).isoformat(),
        "mode": mode,
        "argv": list(arguments),
        "pid": os.getpid(),
        "error_type": type(error).__name__,
        "code": getattr(error, "code", None),
        "message": str(error),
        "traceback": None if isinstance(error, BootstrapError) else traceback.format_exc(),
        "herdr": {
            "workspace_id": os.environ.get("HERDR_WORKSPACE_ID", "").strip() or None,
            "tab_id": os.environ.get("HERDR_TAB_ID", "").strip() or None,
            "pane_id": os.environ.get("HERDR_PANE_ID", "").strip() or None,
            "plugin_state_dir": configured_state_dir or str(plugin_state_dir()),
            "profile": os.environ.get(PROFILE_ENV, "").strip() or None,
            "plugin_context": {
                key: context.get(key) for key in ("workspace_id", "tab_id", "focused_pane_id")
            },
        },
    }
    if carried_failures:
        record["failures"] = list(carried_failures)
    return record


def _write_launcher_error_record(record: dict[str, Any]) -> None:
    flags = os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW
    with _launcher_directory(plugin_state_dir()) as directory_descriptor:
        try:
            descriptor = os.open(
                LAUNCHER_ERRORS_NAME,
                flags | os.O_EXCL,
                0o600,
                dir_fd=directory_descriptor,
            )
            created = True
        except FileExistsError:
            descriptor = os.open(
                LAUNCHER_ERRORS_NAME,
                flags,
                0o600,
                dir_fd=directory_descriptor,
            )
            created = False
        try:
            if created:
                os.fchmod(descriptor, 0o600)
            _validate_launcher_file(descriptor)
            stream = os.fdopen(descriptor, "r+", encoding="utf-8")
            descriptor = -1
            try:
                # The errors file carries its own lock, independent of the launcher
                # state lock, so appending never waits on a dying setup process.
                flock(stream.fileno(), LOCK_EX)
                lines = [line for line in stream.read().splitlines() if line.strip()]
                lines.append(json.dumps(record, sort_keys=True, separators=(",", ":")))
                if len(lines) > LAUNCHER_ERRORS_MAX_RECORDS:
                    lines = lines[-LAUNCHER_ERRORS_MAX_RECORDS:]
                stream.seek(0)
                stream.truncate()
                stream.write("\n".join(lines) + "\n")
                stream.flush()
                os.fsync(stream.fileno())
            finally:
                with suppress(OSError):
                    flock(stream.fileno(), LOCK_UN)
                stream.close()
        finally:
            if descriptor >= 0:
                os.close(descriptor)


def append_launcher_error(mode: str, arguments: Sequence[str], error: BaseException) -> None:
    """Append one JSON failure record; best effort and never raises."""
    with suppress(Exception):  # best effort; the logger must never mask the failure
        _write_launcher_error_record(_launcher_error_record(mode, arguments, error))


def read_launcher_errors() -> list[dict[str, Any]]:
    """Return every parseable record, oldest first; unreadable content is skipped."""
    try:
        raw = launcher_errors_path().read_text(encoding="utf-8")
    except OSError:
        return []
    records: list[dict[str, Any]] = []
    for line in raw.splitlines():
        record: object = None
        with suppress(json.JSONDecodeError):
            record = json.loads(line)
        if isinstance(record, dict):
            records.append(record)
    return records


def show_launcher_errors(limit: int) -> int:
    """Print the most recent launcher failures; one compact line each."""
    records = read_launcher_errors()
    if not records:
        print("no launcher errors recorded")
        return 0
    if limit == 1:
        print(json.dumps(records[-1], indent=2, sort_keys=True))
    else:
        for record in records[-limit:]:
            print(json.dumps(record, sort_keys=True, separators=(",", ":")))
    return 0


def hold_pane_open(mode: str) -> None:
    """Hold a closing interactive pane so the failure stays readable."""
    if os.environ.get(NO_HOLD_ENV, "").strip() == "1":
        return
    if mode not in HOLD_MODES or not sys.stdin.isatty():
        return
    print(HOLD_PROMPT, flush=True)
    try:
        ready, _, _ = select.select([sys.stdin], [], [], HOLD_TIMEOUT_SECONDS)
        if ready:
            sys.stdin.readline()
    except (OSError, ValueError):
        pass


def session_key(environ: Mapping[str, str] = os.environ) -> str:
    socket_path = environ.get("HERDR_SOCKET_PATH", "").strip()
    if not socket_path:
        raise BootstrapError("launcher state requires Herdr plugin socket context")
    try:
        socket_stat = Path(socket_path).stat()
    except OSError as error:
        raise BootstrapError(f"Herdr plugin socket is unavailable: {error}") from error
    identity = (
        f"{socket_path}\0{socket_stat.st_dev}\0{socket_stat.st_ino}\0{socket_stat.st_ctime_ns}"
    )
    return sha256(identity.encode()).hexdigest()[:16]


def launcher_state_path(state_dir: Path) -> Path:
    return state_dir / f"{LAUNCHER_STATE_PREFIX}{session_key()}.json"


def _validate_launcher_state(state: object) -> dict[str, Any]:
    if not isinstance(state, dict) or state.get("schema_version") != LAUNCHER_STATE_VERSION:
        raise BootstrapError("invalid launcher state schema")
    string_fields = (
        "chat_workspace_id",
        "agents_workspace_id",
        "room_pane_id",
        "room_tab_id",
        "last_room_id",
        "chat_placeholder_tab_id",
        "agents_placeholder_tab_id",
        "pending_chat_workspace_label",
        "pending_agents_workspace_label",
        "pending_room_id",
        "pending_room_operation_id",
        "pending_room_profile",
        "selected_profile",
        "agents_cwd",
    )
    if any(field in state and not isinstance(state[field], str) for field in string_fields):
        raise BootstrapError("invalid launcher state fields")
    stale_panes = state.get("stale_room_pane_ids", [])
    if not isinstance(stale_panes, list) or not all(
        isinstance(pane_id, str) for pane_id in stale_panes
    ):
        raise BootstrapError("invalid launcher stale pane state")
    pending_started = state.get("pending_room_started_unix_ms")
    if pending_started is not None and not isinstance(pending_started, int):
        raise BootstrapError("invalid pending room state")
    participant_panes = state.get("participant_pane_ids", {})
    if not isinstance(participant_panes, dict) or not all(
        isinstance(kind, str) and isinstance(pane_id, str)
        for kind, pane_id in participant_panes.items()
    ):
        raise BootstrapError("invalid participant pane state")
    participant_tabs = state.get("participant_tab_ids", {})
    if not isinstance(participant_tabs, dict) or not all(
        isinstance(kind, str) and isinstance(tab_id, str)
        for kind, tab_id in participant_tabs.items()
    ):
        raise BootstrapError("invalid participant tab state")
    pending_tabs = state.get("pending_participant_tabs", {})
    if not isinstance(pending_tabs, dict) or not all(
        isinstance(kind, str) and isinstance(details, dict)
        for kind, details in pending_tabs.items()
    ):
        raise BootstrapError("invalid pending participant state")
    return state


def load_state_file(path: Path) -> dict[str, Any]:
    if not path.exists():
        return {"schema_version": LAUNCHER_STATE_VERSION}
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError) as error:
        raise BootstrapError(f"invalid launcher state: {error}") from error
    return _validate_launcher_state(state)


_launcher_transaction = threading.local()


def _open_launcher_directory(state_dir: Path) -> int:
    state_dir = state_dir.expanduser()
    try:
        state_dir.mkdir(parents=True, mode=0o700)
        directory_created = True
    except FileExistsError:
        directory_created = False
    except OSError as error:
        raise BootstrapError(f"invalid launcher state directory: {error}") from error
    try:
        descriptor = os.open(
            state_dir,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NONBLOCK | os.O_CLOEXEC | os.O_NOFOLLOW,
        )
    except OSError as error:
        raise BootstrapError(f"invalid launcher state directory: {error}") from error
    transferred = False
    try:
        directory_stat = os.fstat(descriptor)
        if not stat.S_ISDIR(directory_stat.st_mode) or directory_stat.st_uid != os.geteuid():
            raise BootstrapError("invalid launcher state directory authority")
        if directory_created:
            os.fchmod(descriptor, 0o700)
        elif stat.S_IMODE(directory_stat.st_mode) != 0o700:
            # Herdr 0.8.2+ pre-creates HERDR_PLUGIN_STATE_DIR under the process
            # umask, so an owned directory can arrive group/world-accessible.
            # An empty one is tightened on the already-open descriptor and
            # adopted; a non-empty one still fails closed because its contents
            # were not written under this plugin's authority.
            if os.listdir(descriptor):
                raise BootstrapError("invalid launcher state directory authority")
            os.fchmod(descriptor, 0o700)
        transferred = True
        return descriptor
    except OSError as error:
        raise BootstrapError(f"invalid launcher state directory: {error}") from error
    finally:
        if not transferred:
            os.close(descriptor)


def _active_launcher_descriptor(state_dir: Path) -> int | None:
    active = getattr(_launcher_transaction, "value", None)
    if active is None:
        return None
    if active[0] != state_dir.expanduser().resolve():
        return None
    return active[1]


@contextmanager
def _launcher_directory(state_dir: Path) -> Iterator[int]:
    active = _active_launcher_descriptor(state_dir)
    if active is not None:
        yield active
        return
    descriptor = _open_launcher_directory(state_dir)
    try:
        yield descriptor
    finally:
        os.close(descriptor)


def _validate_launcher_file(descriptor: int) -> None:
    file_stat = os.fstat(descriptor)
    if (
        not stat.S_ISREG(file_stat.st_mode)
        or file_stat.st_uid != os.geteuid()
        or stat.S_IMODE(file_stat.st_mode) != 0o600
    ):
        raise BootstrapError("invalid launcher state authority")


def _load_launcher_state_at(directory_descriptor: int, name: str) -> dict[str, Any]:
    try:
        descriptor = os.open(
            name,
            os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC | os.O_NOFOLLOW,
            dir_fd=directory_descriptor,
        )
    except FileNotFoundError:
        return {"schema_version": LAUNCHER_STATE_VERSION}
    except OSError as error:
        raise BootstrapError(f"invalid launcher state: {error}") from error
    try:
        _validate_launcher_file(descriptor)
        with os.fdopen(descriptor, encoding="utf-8") as stream:
            descriptor = -1
            try:
                state = json.load(stream)
            except (json.JSONDecodeError, OSError) as error:
                raise BootstrapError(f"invalid launcher state: {error}") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    return _validate_launcher_state(state)


def load_launcher_state(state_dir: Path, state_path: Path | None = None) -> dict[str, Any]:
    path = state_path or launcher_state_path(state_dir)
    with _launcher_directory(state_dir) as directory_descriptor:
        return _load_launcher_state_at(directory_descriptor, path.name)


def save_launcher_state(
    state_dir: Path, state: dict[str, Any], state_path: Path | None = None
) -> None:
    path = state_path or launcher_state_path(state_dir)
    if state_path is not None:
        assert_server_identity(state_dir, state_path)
    state = {**state, "schema_version": LAUNCHER_STATE_VERSION}
    temporary_name = f".{path.name}.{uuid.uuid4().hex}.tmp"
    descriptor = -1
    with _launcher_directory(state_dir) as directory_descriptor:
        try:
            descriptor = os.open(
                temporary_name,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NONBLOCK | os.O_CLOEXEC | os.O_NOFOLLOW,
                0o600,
                dir_fd=directory_descriptor,
            )
            os.fchmod(descriptor, 0o600)
            with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
                descriptor = -1
                stream.write(json.dumps(state, sort_keys=True, separators=(",", ":")) + "\n")
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(
                temporary_name,
                path.name,
                src_dir_fd=directory_descriptor,
                dst_dir_fd=directory_descriptor,
            )
            final_descriptor = os.open(
                path.name,
                os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC | os.O_NOFOLLOW,
                dir_fd=directory_descriptor,
            )
            try:
                os.fchmod(final_descriptor, 0o600)
                _validate_launcher_file(final_descriptor)
            finally:
                os.close(final_descriptor)
            os.fsync(directory_descriptor)
        except OSError as error:
            raise BootstrapError(f"invalid launcher state: {error}") from error
        finally:
            if descriptor >= 0:
                os.close(descriptor)
            with suppress(FileNotFoundError):
                os.unlink(temporary_name, dir_fd=directory_descriptor)


def assert_server_identity(state_dir: Path, state_path: Path) -> None:
    if launcher_state_path(state_dir) != state_path:
        raise BootstrapError("Herdr server changed during group-chat setup; retry the action")


@contextmanager
def launcher_state_lock(state_dir: Path) -> Iterator[Path]:
    if getattr(_launcher_transaction, "value", None) is not None:
        raise BootstrapError("nested launcher state transaction")
    state_dir = state_dir.expanduser()
    state_path = launcher_state_path(state_dir)
    lock_name = state_path.with_suffix(".lock").name
    directory_descriptor = _open_launcher_directory(state_dir)
    try:
        try:
            lock_descriptor = os.open(
                lock_name,
                os.O_RDWR | os.O_CREAT | os.O_NONBLOCK | os.O_CLOEXEC | os.O_NOFOLLOW,
                0o600,
                dir_fd=directory_descriptor,
            )
        except OSError as error:
            raise BootstrapError(f"invalid launcher lock: {error}") from error
        try:
            os.fchmod(lock_descriptor, 0o600)
            _validate_launcher_file(lock_descriptor)
            flock(lock_descriptor, LOCK_EX)
            _launcher_transaction.value = (state_dir.resolve(), directory_descriptor)
            try:
                yield state_path
            finally:
                _launcher_transaction.value = None
                flock(lock_descriptor, LOCK_UN)
        finally:
            os.close(lock_descriptor)
    finally:
        os.close(directory_descriptor)


TOPOLOGY_FIELDS = (
    "chat_workspace_id",
    "agents_workspace_id",
    "room_pane_id",
    "room_tab_id",
    "chat_placeholder_tab_id",
    "agents_placeholder_tab_id",
    "stale_room_pane_ids",
    "pending_chat_workspace_label",
    "pending_agents_workspace_label",
    "pending_room_id",
    "pending_room_operation_id",
    "pending_room_started_unix_ms",
    "agents_cwd",
    "participant_pane_ids",
    "participant_tab_ids",
    "pending_participant_tabs",
)


def clear_topology(state: dict[str, Any]) -> None:
    for field in TOPOLOGY_FIELDS:
        state.pop(field, None)


def load_validated_launcher_state(
    state_dir: Path, herdr_bin: str, state_path: Path | None = None
) -> dict[str, Any]:
    state = load_launcher_state(state_dir, state_path)
    pane_id = state.get("room_pane_id")
    if not pane_id:
        return state
    # Validate the recorded room with the read-only `pane get` inspection only:
    # focusing the pane merely to validate it would steal the caller's focus on
    # every subsequent launch once a room pane exists.
    try:
        response = run_json(herdr_bin, ["pane", "get", pane_id])
    except BootstrapError as error:
        if error.code == "pane_not_found":
            state.pop("room_pane_id", None)
            state.pop("room_tab_id", None)
            return state
        raise
    try:
        pane = response["result"]["pane"]
        matches = (
            str(pane["pane_id"]) == pane_id
            and str(pane["workspace_id"]) == state.get("chat_workspace_id")
            and str(pane["tab_id"]) == state.get("room_tab_id")
        )
    except (KeyError, TypeError):
        matches = False
    if not matches:
        clear_topology(state)
    return state


def workspaces(herdr_bin: str) -> list[dict[str, Any]]:
    listed = run_json(herdr_bin, ["workspace", "list"])
    return [
        workspace
        for workspace in listed.get("result", {}).get("workspaces", [])
        if isinstance(workspace, dict) and workspace.get("workspace_id")
    ]


def workspace_ids(herdr_bin: str) -> set[str]:
    return {str(workspace["workspace_id"]) for workspace in workspaces(herdr_bin)}


def new_room_id() -> str:
    timestamp = datetime.now(UTC).strftime("%Y%m%d-%H%M%S")
    return f"chat-{timestamp}-{uuid.uuid4().hex[:6]}"


def wait_for_shell(herdr_bin: str, pane_id: str, timeout: float = 10) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        payload = run_json(herdr_bin, ["pane", "process-info", "--pane", pane_id])
        processes = (
            payload.get("result", {}).get("process_info", {}).get("foreground_processes", [])
        )
        if len(processes) == 1 and processes[0].get("name") in {
            "bash",
            "fish",
            "nu",
            "sh",
            "zsh",
        }:
            return
        time.sleep(0.1)
    raise BootstrapError("new tab did not reach an interactive shell")


HOOK_DIALOG_NEEDLE = "trust all"
HOOK_MENU_NEEDLE = "continue without trusting"
HOOK_DISMISS_ATTEMPTS = 10
HOOK_DISMISS_INTERVAL_S = 1.0
HOOK_DISMISS_TIMEOUT_S = 5.0


def dismiss_inactive_hook_notice(herdr_bin: str, name: str, pane_id: str) -> None:
    """Dismiss Codex's hooks dialog without trusting hooks the user has not reviewed.

    The dialog can render after `agent start` reports ready, and the visible-pane
    read clips lines at viewport width, so detection retries briefly and matches
    short case-insensitive needles that survive clipping. Herdr's `pane read`
    emits raw terminal text rather than a JSON envelope, so the screen is read
    through the raw-text command helper. Hooks stay inactive: the summary notice
    is closed with esc, and the menu variant is answered with
    "Continue without trusting". Every pane read, retry sleep, and key send
    draws on one monotonic deadline, so slow-but-successful reads cannot hold
    the launcher lock for minutes; an expired deadline returns quietly with
    the notice left untrusted.
    """
    deadline = time.monotonic() + HOOK_DISMISS_TIMEOUT_S
    for attempt in range(HOOK_DISMISS_ATTEMPTS):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return
        text = run_text(
            herdr_bin,
            ["pane", "read", pane_id, "--source", "visible", "--lines", "80"],
            timeout=remaining,
        )
        lowered = text.lower()
        if HOOK_DIALOG_NEEDLE not in lowered:
            if attempt + 1 < HOOK_DISMISS_ATTEMPTS:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return
                time.sleep(min(HOOK_DISMISS_INTERVAL_S, remaining))
            continue
        keys = ("down", "down", "enter") if HOOK_MENU_NEEDLE in lowered else ("esc",)
        for key in keys:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return
            run_json(herdr_bin, ["agent", "send-keys", name, key], timeout=remaining)
        print("notice @codex unreviewed hooks left inactive", flush=True)
        return


AGENT_START_BUSY_ATTEMPTS = 5
AGENT_START_BUSY_INTERVAL_S = 2.0

VERIFY_PANE_ATTEMPTS = 15
VERIFY_PANE_INTERVAL_S = 1.0
_TOKEN_EDGE = "".join((":;,.!()", "[]<>", "\"'"))


def pane_tokens(text: str) -> list[str]:
    """Case-folded whitespace tokens with edge punctuation stripped; internal
    punctuation stays, so `gpt-5.6-sol-01` remains a different token."""
    return [token.strip(_TOKEN_EDGE).lower() for token in text.split()]


def sequence_present(tokens: Sequence[str], sequence: tuple[tuple[str, ...], ...]) -> bool:
    """Bounded sequence match: every element matches consecutive tokens exactly."""
    for start in range(len(tokens) - len(sequence) + 1):
        if all(
            tokens[start + offset] in alternatives for offset, alternatives in enumerate(sequence)
        ):
            return True
    return False


def native_catalog_row_present(command: Sequence[str], provider: str, model: str) -> bool:
    """Require the model's exact catalog rows to name only its expected provider."""
    try:
        result = subprocess.run(
            list(command), capture_output=True, text=True, errors="replace", timeout=30
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    if result.returncode != 0:
        return False
    providers = {
        tokens[0]
        for line in result.stdout.splitlines()
        if len(tokens := line.split()) >= 2 and tokens[1] == model
    }
    return providers == {provider}


def native_pane_proves(
    herdr_bin: str, pane_id: str, proofs: Sequence[tuple[tuple[str, ...], ...]]
) -> bool:
    """Bounded retries for native-pane token evidence; startup UIs render asynchronously."""
    for attempt in range(VERIFY_PANE_ATTEMPTS):
        text = run_text(
            herdr_bin, ["pane", "read", pane_id, "--source", "visible", "--lines", "80"]
        )
        tokens = pane_tokens(text)
        if all(sequence_present(tokens, proof) for proof in proofs):
            return True
        if attempt + 1 < VERIFY_PANE_ATTEMPTS:
            time.sleep(VERIFY_PANE_INTERVAL_S)
    return False


def catalog_proof(participant: Participant) -> bool:
    """Catalog preflight; must pass before any participant tab is created or started."""
    return not participant.catalog_command or (
        participant.provider is not None
        and native_catalog_row_present(
            participant.catalog_command, participant.provider, participant.model
        )
    )


def pane_proof(herdr_bin: str, participant: Participant, pane_id: str) -> bool:
    return not participant.pane_proofs or native_pane_proves(
        herdr_bin, pane_id, participant.pane_proofs
    )


def native_pane_process_proves(
    herdr_bin: str, pane_id: str, argv0: str, expected_args: Sequence[str]
) -> bool:
    """Exact native foreground-process evidence from `pane process-info`.

    A process matches only when its argv0 is exactly the expected executable
    identity and its argv contains the expected arguments as one contiguous
    sequence; an MCP child process, a lookalike model string, or reordered
    arguments never satisfy the proof.
    """
    expected = list(expected_args)

    def matches(process: object) -> bool:
        if not isinstance(process, dict):
            return False
        argv = [str(argument) for argument in process.get("argv", [])]
        # Herdr 0.8.2 reported the executable identity as ``argv0``; the
        # protocol-21 server reports ``name`` instead. Accept either, then
        # fall back to argv[0], and require an exact identity in every case.
        identity = str(process.get("argv0") or process.get("name") or (argv[0] if argv else ""))
        if identity != argv0:
            return False
        return any(
            list(argv[position : position + len(expected)]) == expected
            for position in range(len(argv) - len(expected) + 1)
        )

    for attempt in range(VERIFY_PANE_ATTEMPTS):
        payload = run_json(herdr_bin, ["pane", "process-info", "--pane", pane_id])
        processes = (
            payload.get("result", {}).get("process_info", {}).get("foreground_processes", [])
        )
        if any(matches(process) for process in processes):
            return True
        if attempt + 1 < VERIFY_PANE_ATTEMPTS:
            time.sleep(VERIFY_PANE_INTERVAL_S)
    return False


def reopen_pane_proof(herdr_bin: str, participant: Participant, pane_id: str) -> bool:
    """Reopen proof: profile-driven; fresh proofs when no reopen fields exist."""
    if not participant.reopen_pane_proofs and not participant.reopen_process_argv0:
        return pane_proof(herdr_bin, participant, pane_id)
    if participant.reopen_pane_proofs and not native_pane_proves(
        herdr_bin, pane_id, participant.reopen_pane_proofs
    ):
        return False
    if not participant.reopen_process_argv0:
        return True
    return native_pane_process_proves(
        herdr_bin, pane_id, participant.reopen_process_argv0, participant.reopen_process_args
    )


def live_agent_kind_matches(live_agent: Mapping[str, Any], expected_kind: str) -> bool:
    """Require every reported native-agent identity to match the participant kind."""
    reported = [
        str(live_agent[field]) for field in ("kind", "agent") if live_agent.get(field) is not None
    ]
    return bool(reported) and all(kind == expected_kind for kind in reported)


def needs_native_proof(participant: Participant) -> bool:
    return bool(participant.catalog_command or participant.pane_proofs)


def profile_receipt_payload(profile: str, participants: Sequence[Participant]) -> dict[str, Any]:
    """Deterministic receipt payload carrying the profile's canonical evidence."""

    def entry(participant: Participant) -> dict[str, str]:
        verified = {
            "role": participant.role,
            "target": participant.name,
            "harness": participant.kind,
            "model": participant.model,
            "effort": participant.effort,
            "verification": "native-ui verified",
        }
        if participant.provider:
            verified["provider"] = participant.provider
        return verified

    return {
        "profile": profile,
        "verified": sorted((entry(p) for p in participants), key=lambda e: e["role"]),
    }


def profile_room_exec(profile: str, participants: Sequence[Participant]) -> tuple[list[str], str]:
    """Room argv and receipt payload shared by fresh launch and reopen."""
    arguments = ["--profile", profile]
    for participant in participants:
        arguments.extend(["--agent", f"{participant.role}={participant.name}"])
    arguments.extend(["--synthesizer", participants[0].role])
    receipt = json.dumps(
        profile_receipt_payload(profile, participants), sort_keys=True, separators=(",", ":")
    )
    return arguments, receipt


def participant_tab_env(participant: Participant) -> list[str]:
    """Tab-create env arguments; set only when a participant needs a PATH prefix."""
    if not participant.tab_path_prefix:
        return []
    prefix = str(Path(participant.tab_path_prefix).expanduser())
    parent = os.environ.get("PATH", "")
    # No trailing separator: an empty PATH component would resolve the cwd.
    combined = f"{prefix}{os.pathsep}{parent}" if parent else prefix
    return ["--env", f"PATH={combined}"]


def start_agent(
    herdr_bin: str, name: str, kind: str, pane_id: str, start_args: Sequence[str] = ()
) -> None:
    """Start an agent, retrying herdr's transient agent_pane_busy refusal.

    Native agent arguments are accepted only after a literal `--` pass-through
    separator, added exactly once and only when native arguments exist.
    """
    native_arguments = ["--", *start_args] if start_args else []
    for attempt in range(AGENT_START_BUSY_ATTEMPTS):
        try:
            run_json(
                herdr_bin,
                [
                    "agent",
                    "start",
                    name,
                    "--kind",
                    kind,
                    "--pane",
                    pane_id,
                    "--timeout",
                    "120000",
                    *native_arguments,
                ],
                timeout=None,
            )
            return
        except BootstrapError as error:
            if error.code != "agent_pane_busy" or attempt + 1 == AGENT_START_BUSY_ATTEMPTS:
                raise
            time.sleep(AGENT_START_BUSY_INTERVAL_S)


def ensure_owned_workspace(
    herdr_bin: str,
    cwd: str,
    state_dir: Path,
    state: dict[str, Any],
    state_path: Path,
    *,
    workspace_field: str,
    placeholder_field: str,
    pending_label_field: str,
    display_label: str,
) -> tuple[str, str | None]:
    listed = workspaces(herdr_bin)
    existing = state.get(workspace_field)
    matched = next(
        (workspace for workspace in listed if str(workspace["workspace_id"]) == existing),
        None,
    )
    if matched is None:
        pending_label = state.get(pending_label_field)
        if not pending_label:
            pending_label = f"hgchat-{display_label}-{uuid.uuid4().hex[:10]}"
            state[pending_label_field] = pending_label
            save_launcher_state(state_dir, state, state_path)
        matched = next(
            (workspace for workspace in listed if workspace.get("label") == pending_label),
            None,
        )
        if matched is None:
            assert_server_identity(state_dir, state_path)
            created = run_json(
                herdr_bin,
                [
                    "workspace",
                    "create",
                    "--cwd",
                    cwd,
                    "--label",
                    pending_label,
                    "--no-focus",
                ],
                timeout=None,
            )
            workspace_id = str(created["result"]["workspace"]["workspace_id"])
            placeholder_tab_id = str(created["result"]["tab"]["tab_id"])
        else:
            workspace_id = str(matched["workspace_id"])
            placeholder_tab_id = str(matched["active_tab_id"])
        state[workspace_field] = workspace_id
        state[placeholder_field] = placeholder_tab_id
        state.pop(pending_label_field, None)
        save_launcher_state(state_dir, state, state_path)
    else:
        workspace_id = str(matched["workspace_id"])
        placeholder_tab_id = state.get(placeholder_field)
    if matched is None or matched.get("label") != display_label:
        assert_server_identity(state_dir, state_path)
        run_json(
            herdr_bin,
            ["workspace", "rename", workspace_id, display_label],
            timeout=None,
        )
    return workspace_id, placeholder_tab_id


def ensure_agents_workspace(
    herdr_bin: str, cwd: str, state_dir: Path, state: dict[str, Any], state_path: Path
) -> tuple[str, str | None]:
    return ensure_owned_workspace(
        herdr_bin,
        cwd,
        state_dir,
        state,
        state_path,
        workspace_field="agents_workspace_id",
        placeholder_field="agents_placeholder_tab_id",
        pending_label_field="pending_agents_workspace_label",
        display_label=AGENTS_WORKSPACE_LABEL,
    )


def plugin_context() -> dict[str, Any]:
    try:
        context = json.loads(os.environ.get("HERDR_PLUGIN_CONTEXT_JSON", "{}"))
    except json.JSONDecodeError:
        return {}
    return context if isinstance(context, dict) else {}


def ensure_chat_workspace(
    herdr_bin: str, cwd: str, state_dir: Path, state: dict[str, Any], state_path: Path
) -> tuple[str, str | None]:
    return ensure_owned_workspace(
        herdr_bin,
        cwd,
        state_dir,
        state,
        state_path,
        workspace_field="chat_workspace_id",
        placeholder_field="chat_placeholder_tab_id",
        pending_label_field="pending_chat_workspace_label",
        display_label="group-chat",
    )


def clean_stale_room_panes(
    herdr_bin: str,
    state: dict[str, Any],
    state_dir: Path | None = None,
    state_path: Path | None = None,
) -> None:
    remaining: list[str] = []
    for pane_id in dict.fromkeys(state.get("stale_room_pane_ids", [])):
        try:
            if state_dir is not None and state_path is not None:
                assert_server_identity(state_dir, state_path)
            run_json(herdr_bin, ["plugin", "pane", "close", pane_id])
        except BootstrapError as error:
            if error.code != "plugin_pane_not_found":
                remaining.append(pane_id)
    if remaining:
        state["stale_room_pane_ids"] = remaining
    else:
        state.pop("stale_room_pane_ids", None)


def close_tracked_tab(
    herdr_bin: str,
    state: dict[str, Any],
    state_field: str,
    tab_id: str | None,
    state_dir: Path | None = None,
    state_path: Path | None = None,
) -> None:
    if not tab_id:
        return
    try:
        if state_dir is not None and state_path is not None:
            assert_server_identity(state_dir, state_path)
        run_json(herdr_bin, ["tab", "close", tab_id])
    except BootstrapError as error:
        if error.code != "tab_not_found":
            return
    state.pop(state_field, None)


INDETERMINATE_OPEN_CODES = {"client_disconnected", "command_timeout", "server_unavailable"}
PENDING_ROOM_GRACE_MS = 60_000


def reconcile_pending_room(state: dict[str, Any]) -> None:
    if not state.get("pending_room_id"):
        return
    started = state.get("pending_room_started_unix_ms", 0)
    age_ms = int(time.time() * 1000) - started
    if age_ms < PENDING_ROOM_GRACE_MS:
        raise BootstrapError(
            "a previous room launch is still pending; try Open group chat again shortly",
            code="room_launch_pending",
        )
    state.pop("pending_room_id", None)
    state.pop("pending_room_operation_id", None)
    state.pop("pending_room_profile", None)
    state.pop("pending_room_started_unix_ms", None)


def register_room_pane(
    state: dict[str, Any],
    *,
    workspace_id: str,
    pane_id: str,
    tab_id: str,
    room: str,
    operation_id: str,
    consume_pending: bool = True,
) -> None:
    """Record room pane ownership.

    The inner entrypoint (default) consumes the matching pending operation so
    the launch is claimed complete. The outer launcher registers with
    ``consume_pending=False``: it records pane/tab ownership but retains the
    pending operation/profile so the inner process still observes them after
    it acquires the lock.
    """
    pending_operation = state.get("pending_room_operation_id")
    if pending_operation and pending_operation != operation_id:
        raise BootstrapError("this room launch was superseded by a newer operation")
    if not pending_operation and state.get("room_pane_id") not in {None, "", pane_id}:
        raise BootstrapError("this room launch is no longer current")
    previous_pane_id = state.get("room_pane_id")
    if previous_pane_id and previous_pane_id != pane_id:
        stale_panes = state.setdefault("stale_room_pane_ids", [])
        if previous_pane_id not in stale_panes:
            stale_panes.append(previous_pane_id)
    state.update(
        {
            "chat_workspace_id": workspace_id,
            "room_pane_id": pane_id,
            "room_tab_id": tab_id,
            "last_room_id": room,
        }
    )
    if not consume_pending:
        return
    state.pop("pending_room_id", None)
    state.pop("pending_room_operation_id", None)
    state.pop("pending_room_profile", None)
    state.pop("pending_room_started_unix_ms", None)


def launch_room(open_existing: bool, profile: str | None = None) -> int:
    if profile and open_existing:
        # Opening the retained room never selects a profile; the stored binding wins.
        raise BootstrapError("--profile only applies to a new room launch")
    resolve_profile(profile)  # unknown profiles fail before opening tabs
    herdr_bin = os.environ.get("HERDR_BIN_PATH", "herdr")
    context = plugin_context()
    cwd = str(context.get("focused_pane_cwd") or context.get("workspace_cwd") or Path.cwd())
    state_dir = plugin_state_dir()
    with launcher_state_lock(state_dir) as state_path:
        state = load_launcher_state(state_dir, state_path)
        reconcile_pending_room(state)
        save_launcher_state(state_dir, state, state_path)
        state = load_validated_launcher_state(state_dir, herdr_bin, state_path)
        close_tracked_tab(
            herdr_bin,
            state,
            "chat_placeholder_tab_id",
            state.get("chat_placeholder_tab_id"),
            state_dir,
            state_path,
        )
        close_tracked_tab(
            herdr_bin,
            state,
            "agents_placeholder_tab_id",
            state.get("agents_placeholder_tab_id"),
            state_dir,
            state_path,
        )
        clean_stale_room_panes(herdr_bin, state, state_dir, state_path)
        save_launcher_state(state_dir, state, state_path)

        previous_pane_id = state.get("room_pane_id")
        if open_existing and previous_pane_id:
            try:
                assert_server_identity(state_dir, state_path)
                response = run_json(herdr_bin, ["plugin", "pane", "focus", previous_pane_id])
            except BootstrapError as error:
                if error.code != "plugin_pane_not_found":
                    raise
                state.pop("room_pane_id", None)
                state.pop("room_tab_id", None)
                save_launcher_state(state_dir, state, state_path)
            else:
                print(json.dumps(response, separators=(",", ":")))
                return 0

        workspace_id, placeholder_tab_id = ensure_chat_workspace(
            herdr_bin, cwd, state_dir, state, state_path
        )
        save_launcher_state(state_dir, state, state_path)

        plugin_id = os.environ.get("HERDR_PLUGIN_ID", "terry.herdr-group-chat")
        entrypoint = "room" if open_existing else "new-room"
        room = state.get("last_room_id", "cockpit") if open_existing else new_room_id()
        operation_id = uuid.uuid4().hex
        pane_arguments = [
            "plugin",
            "pane",
            "open",
            "--plugin",
            plugin_id,
            "--entrypoint",
            entrypoint,
            "--placement",
            "tab",
            "--workspace",
            workspace_id,
            "--env",
            f"{ROOM_ENV}={room}",
            "--env",
            f"{AGENT_CWD_ENV}={cwd}",
            "--env",
            f"{ROOM_OPERATION_ENV}={operation_id}",
        ]
        if profile:
            pane_arguments.extend(["--env", f"{PROFILE_ENV}={profile}"])
        agents_workspace_id = state.get("agents_workspace_id")
        if agents_workspace_id and agents_workspace_id in workspace_ids(herdr_bin):
            pane_arguments.extend(["--env", f"{AGENTS_WORKSPACE_ENV}={agents_workspace_id}"])
        # A fresh launch must never steal the caller's focus: neither the room
        # pane nor either workspace takes it. The explicit Open group chat action
        # is focus-oriented, so recreating a missing room pane may use --focus.
        pane_arguments.append("--focus" if open_existing else "--no-focus")
        state["pending_room_id"] = room
        state["pending_room_operation_id"] = operation_id
        if profile:
            state["pending_room_profile"] = profile
        state["pending_room_started_unix_ms"] = int(time.time() * 1000)
        save_launcher_state(state_dir, state, state_path)
        try:
            assert_server_identity(state_dir, state_path)
            response = run_json(herdr_bin, pane_arguments, timeout=None)
        except BootstrapError as error:
            if error.code not in INDETERMINATE_OPEN_CODES:
                state.pop("pending_room_id", None)
                state.pop("pending_room_operation_id", None)
                state.pop("pending_room_profile", None)
                state.pop("pending_room_started_unix_ms", None)
                save_launcher_state(state_dir, state, state_path)
            raise
        pane = response["result"]["plugin_pane"]["pane"]
        pane_id = str(pane["pane_id"])
        tab_id = str(pane["tab_id"])
        register_room_pane(
            state,
            workspace_id=workspace_id,
            pane_id=pane_id,
            tab_id=tab_id,
            room=room,
            operation_id=operation_id,
            consume_pending=False,
        )
        save_launcher_state(state_dir, state, state_path)
        assert_server_identity(state_dir, state_path)
        run_json(herdr_bin, ["tab", "rename", tab_id, "group-chat"])
        close_tracked_tab(
            herdr_bin,
            state,
            "chat_placeholder_tab_id",
            placeholder_tab_id,
            state_dir,
            state_path,
        )
        clean_stale_room_panes(herdr_bin, state, state_dir, state_path)
        save_launcher_state(state_dir, state, state_path)
    print(json.dumps(response, separators=(",", ":")))
    return 0


def same_cwd(left: str, right: str) -> bool:
    return Path(left).expanduser().resolve() == Path(right).expanduser().resolve()


def ownership_mismatch_reasons(
    live_agent: Mapping[str, Any],
    agents_workspace_id: str,
    live_cwd: str,
    agent_cwd: str,
    recorded_pane_id: str | None,
) -> list[str]:
    """Name every failed ownership check for an already-live participant."""
    reasons: list[str] = []
    if str(live_agent.get("workspace_id")) != agents_workspace_id:
        reasons.append("different workspace")
    if not live_cwd or not same_cwd(live_cwd, agent_cwd):
        reasons.append("different cwd")
    if recorded_pane_id != str(live_agent.get("pane_id")):
        reasons.append("pane not recorded")
    return reasons


def pending_participant_tab_matches(live_agent: Mapping[str, Any], pending: object) -> bool:
    """Accept a first-run agent only when it is still in its exact pending tab."""
    if not isinstance(pending, dict):
        return False
    pending_pane_id = pending.get("pane_id")
    pending_tab_id = pending.get("tab_id")
    live_pane_id = live_agent.get("pane_id")
    live_tab_id = live_agent.get("tab_id")
    return (
        isinstance(pending_pane_id, str)
        and isinstance(pending_tab_id, str)
        and bool(pending_pane_id)
        and bool(pending_tab_id)
        and pending_pane_id == live_pane_id
        and pending_tab_id == live_tab_id
    )


def blocked_startup_prompt_guidance(participant: Participant) -> str:
    """Explain how to resume a native startup prompt without answering it."""
    product = {"claude": "Claude", "codex": "Codex"}.get(participant.kind, participant.kind)
    return (
        f"@{participant.role}: {product} is waiting at a blocked startup prompt in the "
        "preserved tab; answer the prompt there, then rerun group-chat setup"
    )


def blocked_pending_participant_tab_exists(
    herdr_bin: str, agents_workspace_id: str, pending: object
) -> bool:
    """Return whether the exact blocked-startup tab remains in the owned workspace."""
    if not isinstance(pending, dict) or pending.get("blocked_startup") is not True:
        return False
    tab_id = pending.get("tab_id")
    pane_id = pending.get("pane_id")
    if not isinstance(tab_id, str) or not tab_id or not isinstance(pane_id, str) or not pane_id:
        return False
    listed = run_json(herdr_bin, ["tab", "list", "--workspace", agents_workspace_id])
    for tab in listed.get("result", {}).get("tabs", []):
        if not isinstance(tab, dict) or tab.get("tab_id") != tab_id:
            continue
        if "workspace_id" in tab and str(tab["workspace_id"]) != agents_workspace_id:
            continue
        root_pane = tab.get("root_pane")
        listed_pane_id = tab.get("pane_id") or tab.get("root_pane_id")
        if isinstance(root_pane, dict):
            listed_pane_id = listed_pane_id or root_pane.get("pane_id")
        return listed_pane_id is None or (
            isinstance(listed_pane_id, str) and listed_pane_id == pane_id
        )
    return False


def infer_owned_agents_cwd(herdr_bin: str, agents_workspace_id: str, requested_cwd: str) -> str:
    listed = run_json(herdr_bin, ["agent", "list"])
    expected_names = {name for _, name in PARTICIPANTS} | {
        participant.name
        for participants in PROFILE_PARTICIPANTS.values()
        for participant in participants
    }
    owned_cwds = {
        str(item.get("cwd") or item.get("foreground_cwd"))
        for item in listed.get("result", {}).get("agents", [])
        if isinstance(item, dict)
        and item.get("name") in expected_names
        and str(item.get("workspace_id")) == agents_workspace_id
        and (item.get("cwd") or item.get("foreground_cwd"))
    }
    return owned_cwds.pop() if len(owned_cwds) == 1 else requested_cwd


def close_pending_participant_tab(
    herdr_bin: str,
    agents_workspace_id: str,
    pending: dict[str, Any],
    state_dir: Path,
    state_path: Path,
) -> None:
    tab_id = pending.get("tab_id")
    if not tab_id and pending.get("label"):
        listed = run_json(herdr_bin, ["tab", "list", "--workspace", agents_workspace_id])
        matches = [
            tab
            for tab in listed.get("result", {}).get("tabs", [])
            if isinstance(tab, dict) and tab.get("label") == pending["label"]
        ]
        if len(matches) == 1:
            tab_id = matches[0].get("tab_id")
    if tab_id:
        assert_server_identity(state_dir, state_path)
        try:
            run_json(herdr_bin, ["tab", "close", str(tab_id)])
        except BootstrapError as error:
            if error.code != "tab_not_found":
                raise


def close_recorded_participant(
    herdr_bin: str,
    pane_id: str,
    tab_id: str | None,
    state_dir: Path,
    state_path: Path,
) -> None:
    assert_server_identity(state_dir, state_path)
    arguments = ["tab", "close", tab_id] if tab_id else ["pane", "close", pane_id]
    try:
        run_json(herdr_bin, arguments)
    except BootstrapError as error:
        if error.code not in {"tab_not_found", "pane_not_found"}:
            raise


def start_participants(
    herdr_bin: str,
    agent_cwd: str,
    agents_workspace_id: str,
    state_dir: Path,
    state_path: Path,
    state: dict[str, Any],
    participants: Sequence[Participant] | None = None,
) -> tuple[list[str], list[Participant]]:
    """Start (or re-verify) the requested participants, returning setup failures.

    Exactly one participant is recorded per role: the same exact named
    participant is reused, while a different requested name for a recorded role
    intentionally closes the plugin-recorded tab before starting its
    replacement. Only participants whose native host evidence verified become
    routable; a live session under the requested name that mismatches its kind,
    ownership, or native evidence is excluded without being closed.
    """
    if participants is None:
        participants = resolve_profile(None)
    listed = run_json(herdr_bin, ["agent", "list"])
    agents = listed.get("result", {}).get("agents", [])
    live_agents = {
        item["name"]: item for item in agents if isinstance(item, dict) and item.get("name")
    }

    failures: list[str] = []
    participant_panes = state.setdefault("participant_pane_ids", {})
    participant_tabs = state.setdefault("participant_tab_ids", {})
    pending_tabs = state.setdefault("pending_participant_tabs", {})
    for participant in participants:
        role = participant.role
        name = participant.name
        live_agent = live_agents.get(name)
        if live_agent is not None:
            live_cwd = str(live_agent.get("cwd") or live_agent.get("foreground_cwd") or "")
            recorded_pane_id = participant_panes.get(role)
            pending = pending_tabs.get(role)
            pending_matches_live_agent = pending_participant_tab_matches(live_agent, pending)
            blocked_pending_live_agent = (
                isinstance(pending, dict)
                and pending.get("blocked_startup") is True
                and pending_matches_live_agent
            )
            has_recorded_pane = bool(recorded_pane_id)
            if not live_agent_kind_matches(live_agent, participant.kind):
                failures.append(
                    f"@{role}: {name} is already running with a different agent kind; "
                    "the session was left open"
                )
                print(f"failed @{role}", flush=True)
                continue
            if (
                str(live_agent.get("workspace_id")) != agents_workspace_id
                or not live_cwd
                or not same_cwd(live_cwd, agent_cwd)
                or (has_recorded_pane and recorded_pane_id != str(live_agent.get("pane_id")))
                or (not has_recorded_pane and not pending_matches_live_agent)
            ):
                reasons = ", ".join(
                    ownership_mismatch_reasons(
                        live_agent, agents_workspace_id, live_cwd, agent_cwd, recorded_pane_id
                    )
                )
                failures.append(
                    f"@{role}: {name} is live in workspace "
                    f"{live_agent.get('workspace_id')} but this launcher owns "
                    f"{agents_workspace_id} ({reasons}); run the Adopt stale "
                    "group-chat peers action or close that peer tab"
                )
                print(f"failed @{role}", flush=True)
                continue
            if needs_native_proof(participant) and not (
                catalog_proof(participant)
                and reopen_pane_proof(herdr_bin, participant, str(live_agent["pane_id"]))
            ):
                if blocked_pending_live_agent:
                    failures.append(blocked_startup_prompt_guidance(participant))
                    print(f"pending @{role} trust", flush=True)
                    continue
                failures.append(
                    f"@{role}: {name} failed native-ui verification; the session was left open"
                )
                print(f"unverified @{role}", flush=True)
                continue
            participant_panes[role] = str(live_agent["pane_id"])
            participant_tabs[role] = str(live_agent["tab_id"])
            if has_recorded_pane and pending and pending.get("tab_id") != live_agent.get("tab_id"):
                # A verified recorded participant retains its prior stale-tab
                # cleanup behavior. Exact pending promotion is only for roles
                # that did not yet record a participant pane.
                try:
                    close_pending_participant_tab(
                        herdr_bin, agents_workspace_id, pending, state_dir, state_path
                    )
                except BootstrapError as error:
                    failures.append(f"@{role}: pending-tab cleanup failed: {error}")
                    print(f"cleanup @{role} pending", flush=True)
                    save_launcher_state(state_dir, state, state_path)
                    continue
            if pending is not None:
                # A pending tab is promoted only after the exact live pane and
                # tab pair passed every ownership and native-proof check above,
                # or a recorded participant's stale pending tab was closed.
                pending_tabs.pop(role, None)
            save_launcher_state(state_dir, state, state_path)
            print(f"ready  @{role} (existing {name})", flush=True)
            continue
        print(f"start  @{role}", flush=True)
        recorded_pane_id = participant_panes.get(role)
        if recorded_pane_id:
            # One recorded participant per role: a different requested name
            # replaces the recorded occupant. The replacement is announced only
            # once its plugin-recorded tab has actually closed, so a failed
            # close reports `cleanup @role previous` instead.
            try:
                close_recorded_participant(
                    herdr_bin,
                    recorded_pane_id,
                    participant_tabs.get(role),
                    state_dir,
                    state_path,
                )
            except BootstrapError as error:
                failures.append(f"@{role}: previous-tab cleanup failed: {error}")
                print(f"cleanup @{role} previous", flush=True)
                continue
            print(f"replace @{role}", flush=True)
            participant_panes.pop(role, None)
            participant_tabs.pop(role, None)
            save_launcher_state(state_dir, state, state_path)
        pending = pending_tabs.get(role)
        if pending:
            if pending.get("blocked_startup") is True:
                try:
                    blocked_tab_exists = blocked_pending_participant_tab_exists(
                        herdr_bin, agents_workspace_id, pending
                    )
                except BootstrapError as error:
                    failures.append(f"@{role}: blocked-startup tab check failed: {error}")
                    print(f"blocked @{role} check", flush=True)
                    continue
                if blocked_tab_exists:
                    failures.append(blocked_startup_prompt_guidance(participant))
                    print(f"pending @{role} trust", flush=True)
                    continue
                pending_tabs.pop(role, None)
                save_launcher_state(state_dir, state, state_path)
                pending = None
            if pending:
                age_ms = int(time.time() * 1000) - int(pending.get("started_unix_ms", 0))
                if age_ms < PENDING_ROOM_GRACE_MS:
                    failures.append(f"@{role}: previous agent start is still pending")
                    print(f"pending @{role}", flush=True)
                    continue
                try:
                    close_pending_participant_tab(
                        herdr_bin, agents_workspace_id, pending, state_dir, state_path
                    )
                except BootstrapError as error:
                    failures.append(f"@{role}: pending-tab cleanup failed: {error}")
                    print(f"cleanup @{role} pending", flush=True)
                    continue
                pending_tabs.pop(role, None)
                save_launcher_state(state_dir, state, state_path)
        try:
            if not catalog_proof(participant):
                failures.append(
                    f"@{role}: {name} failed the native catalog preflight; no tab was created"
                )
                print(f"unverified @{role} (catalog)", flush=True)
                continue
            pending_label = f"hgchat-{role}-{uuid.uuid4().hex[:10]}"
            pending_tabs[role] = {
                "label": pending_label,
                "started_unix_ms": int(time.time() * 1000),
            }
            save_launcher_state(state_dir, state, state_path)
            assert_server_identity(state_dir, state_path)
            created = run_json(
                herdr_bin,
                [
                    "tab",
                    "create",
                    "--workspace",
                    agents_workspace_id,
                    "--cwd",
                    agent_cwd,
                    "--label",
                    pending_label,
                    *participant_tab_env(participant),
                    "--no-focus",
                ],
                timeout=None,
            )
            pane_id = str(created["result"]["root_pane"]["pane_id"])
            participant_tab_id = str(created["result"]["tab"]["tab_id"])
            pending_tabs[role] = {
                "label": pending_label,
                "pane_id": pane_id,
                "tab_id": participant_tab_id,
                "started_unix_ms": int(time.time() * 1000),
            }
            save_launcher_state(state_dir, state, state_path)
            wait_for_shell(herdr_bin, pane_id)
            assert_server_identity(state_dir, state_path)
            start_agent(herdr_bin, name, participant.kind, pane_id, participant.start_args)
            if needs_native_proof(participant) and not pane_proof(herdr_bin, participant, pane_id):
                try:
                    close_pending_participant_tab(
                        herdr_bin, agents_workspace_id, pending_tabs[role], state_dir, state_path
                    )
                except BootstrapError as cleanup_error:
                    failures.append(f"@{role}: pending-tab cleanup failed: {cleanup_error}")
                else:
                    pending_tabs.pop(role, None)
                participant_panes.pop(role, None)
                participant_tabs.pop(role, None)
                save_launcher_state(state_dir, state, state_path)
                failures.append(
                    f"@{role}: {name} failed native-ui verification; the new tab was closed"
                )
                print(f"unverified @{role}", flush=True)
                continue
            participant_panes[role] = pane_id
            participant_tabs[role] = participant_tab_id
            pending_tabs.pop(role, None)
            save_launcher_state(state_dir, state, state_path)
            with suppress(BootstrapError):
                assert_server_identity(state_dir, state_path)
                run_json(
                    herdr_bin,
                    ["tab", "rename", participant_tab_id, f"{role} · group-chat"],
                )
            if participant.kind == "codex":
                with suppress(BootstrapError):
                    assert_server_identity(state_dir, state_path)
                    dismiss_inactive_hook_notice(herdr_bin, name, pane_id)
            print(f"ready  @{role}", flush=True)
        except (BootstrapError, KeyError, TypeError) as error:
            if isinstance(error, BootstrapError) and error.code == "agent_not_ready":
                # Herdr has started the native agent but it is blocked in its
                # own trust UI. Preserve the recorded pane/tab so a later
                # setup retry can prove and promote that exact surface.
                pending_tabs[role]["blocked_startup"] = True
                save_launcher_state(state_dir, state, state_path)
                failures.append(blocked_startup_prompt_guidance(participant))
                print(f"pending @{role} trust", flush=True)
                continue
            if not isinstance(error, BootstrapError) or error.code not in INDETERMINATE_OPEN_CODES:
                pending = pending_tabs.get(role)
                if pending:
                    try:
                        close_pending_participant_tab(
                            herdr_bin,
                            agents_workspace_id,
                            pending,
                            state_dir,
                            state_path,
                        )
                    except BootstrapError as cleanup_error:
                        failures.append(f"@{role}: pending-tab cleanup failed: {cleanup_error}")
                    else:
                        pending_tabs.pop(role, None)
                save_launcher_state(state_dir, state, state_path)
            failures.append(f"@{role}: {error}")
            print(f"failed @{role}", flush=True)
    if not participant_panes:
        state.pop("participant_pane_ids", None)
    if not participant_tabs:
        state.pop("participant_tab_ids", None)
    if not pending_tabs:
        state.pop("pending_participant_tabs", None)
    save_launcher_state(state_dir, state, state_path)
    return failures


def all_configured_participants() -> tuple[Participant, ...]:
    """Every configured participant — classic set plus every profile — name-unique."""
    configured = [
        *resolve_profile(None),
        *(
            participant
            for participants in PROFILE_PARTICIPANTS.values()
            for participant in participants
        ),
    ]
    seen: set[str] = set()
    unique: list[Participant] = []
    for participant in configured:
        if participant.name not in seen:
            seen.add(participant.name)
            unique.append(participant)
    return tuple(unique)


def _read_json_file_at(directory_descriptor: int, name: str) -> dict[str, Any] | None:
    """Read one launcher-owned JSON file read-only; None when not readable."""
    try:
        descriptor = os.open(
            name,
            os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC | os.O_NOFOLLOW,
            dir_fd=directory_descriptor,
        )
    except OSError:
        return None
    try:
        file_stat = os.fstat(descriptor)
        if not stat.S_ISREG(file_stat.st_mode) or file_stat.st_uid != os.geteuid():
            return None
        with os.fdopen(descriptor, encoding="utf-8") as stream:
            descriptor = -1
            try:
                payload = json.load(stream)
            except (OSError, ValueError):
                return None
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    return payload if isinstance(payload, dict) else None


def other_state_workspace_claims(state_dir: Path, state_path: Path) -> dict[str, str]:
    """Map each workspace id recorded by another launcher state file to its name.

    The other files are read read-only and skipped when unreadable, because a
    launcher whose state cannot be parsed can no longer act on any workspace.
    """
    claims: dict[str, str] = {}
    with _launcher_directory(state_dir) as directory_descriptor:
        try:
            names = os.listdir(directory_descriptor)
        except OSError:
            return claims
        for name in sorted(names):
            if not name.startswith(LAUNCHER_STATE_PREFIX) or not name.endswith(".json"):
                continue
            if name == state_path.name:
                continue
            state = _read_json_file_at(directory_descriptor, name)
            if state is None:
                continue
            for field in ("agents_workspace_id", "chat_workspace_id"):
                workspace_id = state.get(field)
                if isinstance(workspace_id, str) and workspace_id:
                    claims.setdefault(workspace_id, name)
    return claims


def adopt_stale_peers() -> int:
    """Adopt live group-chat peers orphaned by a Herdr server restart.

    A restart gives the launcher a fresh state key, so peers the previous
    instance started fail the pane-ownership checks and an atomic profile
    aborts. Adoption is an explicit, fail-closed action: every live configured
    peer must match its kind and native evidence, all candidates must share
    exactly one `agents · group-chat` workspace that no other launcher state
    file still claims, and they must share one cwd. On any mismatch nothing is
    adopted; no pane is ever closed, prompted, or moved.
    """
    herdr_bin = os.environ.get("HERDR_BIN_PATH", "herdr")
    state_dir = plugin_state_dir()
    with launcher_state_lock(state_dir) as state_path:
        state = load_launcher_state(state_dir, state_path)
        listed = run_json(herdr_bin, ["agent", "list"])
        agents = listed.get("result", {}).get("agents", [])
        live_agents = {
            item["name"]: item for item in agents if isinstance(item, dict) and item.get("name")
        }

        problems: list[str] = []
        by_role: dict[str, list[tuple[Participant, dict[str, Any]]]] = {}
        for participant in all_configured_participants():
            live_agent = live_agents.get(participant.name)
            if live_agent is None:
                continue
            if not live_agent_kind_matches(live_agent, participant.kind):
                problems.append(
                    f"@{participant.role}: {participant.name} is live with a "
                    "different agent kind; the session was left open"
                )
                continue
            by_role.setdefault(participant.role, []).append((participant, live_agent))
        adopted: list[tuple[Participant, dict[str, Any]]] = []
        blocked_roles: set[str] = set()
        for participant in all_configured_participants():
            entries = by_role.get(participant.role)
            if not entries or participant.role in blocked_roles:
                continue
            if len(entries) > 1:
                both = ", ".join(sorted(entry.name for entry, _ in entries))
                problems.append(
                    f"@{participant.role}: {both} are both live; one role cannot adopt two peers"
                )
                blocked_roles.add(participant.role)
                continue
            if entries[0][0].name == participant.name:
                adopted.append(entries[0])
        if not adopted:
            problems.append("no configured group-chat participant is live")

        for participant, live_agent in adopted:
            pane_id = str(live_agent.get("pane_id") or "")
            if needs_native_proof(participant) and not (
                pane_id
                and catalog_proof(participant)
                and reopen_pane_proof(herdr_bin, participant, pane_id)
            ):
                problems.append(
                    f"@{participant.role}: {participant.name} failed native-ui "
                    "verification; the session was left open"
                )

        listed_workspaces = workspaces(herdr_bin)
        workspaces_by_id = {
            str(workspace["workspace_id"]): workspace for workspace in listed_workspaces
        }
        candidate_ids = {str(live_agent.get("workspace_id") or "") for _, live_agent in adopted}
        candidate_ids.discard("")
        adopted_workspace_id = candidate_ids.pop() if len(candidate_ids) == 1 else ""
        if len(candidate_ids) > 1:
            problems.append(
                "the live peers span several workspaces: " + ", ".join(sorted(candidate_ids))
            )
        elif adopted_workspace_id:
            workspace = workspaces_by_id.get(adopted_workspace_id)
            if workspace is None:
                problems.append(f"workspace {adopted_workspace_id} no longer exists")
            elif str(workspace.get("label")) != AGENTS_WORKSPACE_LABEL:
                problems.append(
                    f"workspace {adopted_workspace_id} is labelled "
                    f"{workspace.get('label')!r}, not {AGENTS_WORKSPACE_LABEL!r}"
                )
            else:
                claims = {
                    workspace_id: name
                    for workspace_id, name in other_state_workspace_claims(
                        state_dir, state_path
                    ).items()
                    if workspace_id in workspaces_by_id
                }
                claimed_by = claims.get(adopted_workspace_id)
                if claimed_by is not None:
                    problems.append(
                        f"workspace {adopted_workspace_id} is still recorded by "
                        f"{claimed_by}; another launcher state owns it"
                    )

        cwd_groups: dict[str, list[str]] = {}
        for participant, live_agent in adopted:
            live_cwd = str(live_agent.get("cwd") or live_agent.get("foreground_cwd") or "")
            if not live_cwd:
                problems.append(f"@{participant.role}: {participant.name} reports no cwd")
            else:
                cwd_groups.setdefault(str(Path(live_cwd).expanduser().resolve()), []).append(
                    f"{participant.name} ({live_cwd})"
                )
        common_cwd = ""
        if len(cwd_groups) > 1:
            problems.append(
                "the live peers do not share one cwd: "
                + "; ".join(", ".join(names) for names in cwd_groups.values())
            )
        elif cwd_groups:
            common_cwd = str(
                next(
                    live_agent.get("cwd") or live_agent.get("foreground_cwd")
                    for _, live_agent in adopted
                )
            )

        if problems:
            raise BootstrapError(
                "the stale group-chat peers were not adopted:\n"
                + "\n".join(f"- {problem}" for problem in problems),
                code="adopt_refused",
                failures=problems,
            )

        previous_agents_workspace_id = str(state.get("agents_workspace_id") or "")
        participant_panes = state.setdefault("participant_pane_ids", {})
        participant_tabs = state.setdefault("participant_tab_ids", {})
        for participant, live_agent in adopted:
            participant_panes[participant.role] = str(live_agent["pane_id"])
            participant_tabs[participant.role] = str(live_agent["tab_id"])
            print(
                f"adopted @{participant.role} ({participant.name}, pane {live_agent['pane_id']})",
                flush=True,
            )
        state["agents_workspace_id"] = adopted_workspace_id
        state["agents_cwd"] = common_cwd
        save_launcher_state(state_dir, state, state_path)
        summary = (
            f"adopted {len(adopted)} peers in workspace {adopted_workspace_id} "
            f"({AGENTS_WORKSPACE_LABEL}), cwd {common_cwd}"
        )
        if (
            previous_agents_workspace_id
            and previous_agents_workspace_id != adopted_workspace_id
            and previous_agents_workspace_id in workspaces_by_id
        ):
            summary += (
                f"; the previous placeholder workspace {previous_agents_workspace_id} "
                "was left untouched"
            )
        print(summary, flush=True)
    return 0


def main() -> int:
    herdr_bin = os.environ.get("HERDR_BIN_PATH", "herdr")
    profile = os.environ.get(PROFILE_ENV, "").strip() or None
    participants = resolve_profile(profile)  # unknown profiles fail before any tab opens
    workspace_id = os.environ.get("HERDR_WORKSPACE_ID", "").strip()
    tab_id = os.environ.get("HERDR_TAB_ID", "").strip()
    if not workspace_id:
        raise BootstrapError("New group chat must run inside a Herdr workspace")

    context = plugin_context()
    requested_agent_cwd = os.environ.get(AGENT_CWD_ENV, "").strip() or str(
        context.get("focused_pane_cwd") or context.get("workspace_cwd") or Path.cwd()
    )
    state_dir = plugin_state_dir()
    pane_id = os.environ.get("HERDR_PANE_ID", "").strip()
    operation_id = os.environ.get(ROOM_OPERATION_ENV, "").strip()
    room = os.environ.get(ROOM_ENV, "").strip() or new_room_id()
    if not pane_id or not tab_id or not operation_id:
        raise BootstrapError("New group chat is missing its Herdr pane context")
    with launcher_state_lock(state_dir) as state_path:
        state = load_launcher_state(state_dir, state_path)
        if profile is not None and (
            state.get("pending_room_operation_id") != operation_id
            or state.get("pending_room_profile") != profile
        ):
            raise BootstrapError(
                "room profile was not tied to this launch operation; retry the action",
                code="profile_operation_mismatch",
            )
        register_room_pane(
            state,
            workspace_id=workspace_id,
            pane_id=pane_id,
            tab_id=tab_id,
            room=room,
            operation_id=operation_id,
        )
        existing_agents_workspace = str(state.get("agents_workspace_id") or "")
        agent_cwd = str(state.get("agents_cwd") or "")
        if not agent_cwd:
            agent_cwd = (
                infer_owned_agents_cwd(herdr_bin, existing_agents_workspace, requested_agent_cwd)
                if existing_agents_workspace
                else requested_agent_cwd
            )
            state["agents_cwd"] = agent_cwd
        agents_workspace_id, placeholder_tab_id = ensure_agents_workspace(
            herdr_bin, agent_cwd, state_dir, state, state_path
        )
        save_launcher_state(state_dir, state, state_path)

        failures = start_participants(
            herdr_bin,
            agent_cwd,
            agents_workspace_id,
            state_dir,
            state_path,
            state,
            participants=participants,
        )

        if profile is not None and failures:
            # A profile room is atomic: it never opens with zero or one role.
            state.pop("selected_profile", None)
            save_launcher_state(state_dir, state, state_path)
            raise BootstrapError(
                f"the {profile} profile requires every participant to verify "
                "native-ui evidence; the room was not opened:\n"
                + "\n".join(f"- {failure}" for failure in failures),
                code="profile_incomplete",
                failures=failures,
            )
        if profile:
            # Trust the profile only for this room, whose id lands in last_room_id.
            state["selected_profile"] = profile
        else:
            state.pop("selected_profile", None)
        save_launcher_state(state_dir, state, state_path)

        close_tracked_tab(
            herdr_bin,
            state,
            "agents_placeholder_tab_id",
            placeholder_tab_id,
            state_dir,
            state_path,
        )
        if tab_id:
            with suppress(BootstrapError):
                assert_server_identity(state_dir, state_path)
                run_json(herdr_bin, ["tab", "rename", tab_id, "group-chat"])
        clean_stale_room_panes(herdr_bin, state, state_dir, state_path)
        save_launcher_state(state_dir, state, state_path)

    if failures:
        print("\nUnavailable participants:", flush=True)
        for failure in failures:
            print(f"- {failure}", flush=True)
        print("\nOpening the room with the available peers...", flush=True)
    else:
        print("\nAll participants ready. Opening the room...", flush=True)

    # Hand the failures to the room process so they survive the setup pane's
    # redraw; a launch without failures must never show a previous launch's.
    if failures:
        os.environ[SETUP_FAILURES_ENV] = "\n".join(
            failure.replace("\n", " ") for failure in failures
        )
    else:
        os.environ.pop(SETUP_FAILURES_ENV, None)

    executable = Path(__file__).resolve().parent / "herdr-group-chat"
    arguments = [str(executable), "--room", room, "--agents-workspace", agents_workspace_id]
    if profile:
        profile_arguments, receipt = profile_room_exec(profile, participants)
        arguments.extend(profile_arguments)
        os.environ[PROFILE_RECEIPT_ENV] = receipt
    else:
        os.environ.pop(PROFILE_RECEIPT_ENV, None)
    os.execv(
        str(executable),
        arguments,
    )


def reverify_profile_participants(
    herdr_bin: str,
    agents_workspace_id: str,
    agents_cwd: str,
    state: dict[str, Any],
    participants: Sequence[Participant],
) -> None:
    """Re-verify each role against its exact live agent and native evidence.

    Uses the same catalog/pane primitives as a fresh launch; never starts or
    closes anything, and any mismatch stops the reopen before exec.
    """
    if not agents_workspace_id or not agents_cwd:
        raise BootstrapError(
            "room profile re-verification is missing the agents workspace or cwd",
            code="profile_reverify_failed",
        )
    listed = run_json(herdr_bin, ["agent", "list"])
    agents = listed.get("result", {}).get("agents", [])
    live_agents = {
        item["name"]: item for item in agents if isinstance(item, dict) and item.get("name")
    }
    participant_panes = state.get("participant_pane_ids", {})
    participant_tabs = state.get("participant_tab_ids", {})
    for participant in participants:
        live_agent = live_agents.get(participant.name)
        live_cwd = str(
            (live_agent or {}).get("cwd") or (live_agent or {}).get("foreground_cwd") or ""
        )
        recorded_pane = participant_panes.get(participant.role)
        if (
            live_agent is None
            or not live_agent_kind_matches(live_agent, participant.kind)
            or str(live_agent.get("workspace_id")) != agents_workspace_id
            or str(live_agent.get("pane_id")) != recorded_pane
            or str(live_agent.get("tab_id")) != participant_tabs.get(participant.role)
            or not live_cwd
            or not same_cwd(live_cwd, agents_cwd)
            or not catalog_proof(participant)
            or not reopen_pane_proof(herdr_bin, participant, recorded_pane)
        ):
            raise BootstrapError(
                f"@{participant.role}: {participant.name} failed room profile re-verification; "
                "the room was not reopened",
                code="profile_reverify_failed",
            )


def room_entrypoint() -> int:
    herdr_bin = os.environ.get("HERDR_BIN_PATH", "herdr")
    workspace_id = os.environ.get("HERDR_WORKSPACE_ID", "").strip()
    pane_id = os.environ.get("HERDR_PANE_ID", "").strip()
    tab_id = os.environ.get("HERDR_TAB_ID", "").strip()
    operation_id = os.environ.get(ROOM_OPERATION_ENV, "").strip()
    room = os.environ.get(ROOM_ENV, "").strip()
    if not all((workspace_id, pane_id, tab_id, operation_id, room)):
        raise BootstrapError("Group chat is missing its Herdr pane context")
    state_dir = plugin_state_dir()
    with launcher_state_lock(state_dir) as state_path:
        state = load_launcher_state(state_dir, state_path)
        # The profile is trusted only for the single retained room: the stored
        # binding is last_room_id, so a stale cross-room profile is rejected
        # before registration could rewrite it.
        profile = str(state.get("selected_profile") or "") or None
        if profile is not None and state.get("last_room_id") != room:
            raise BootstrapError(
                "stored room profile is bound to a different room; the room was "
                "not reopened as a profile room",
                code="profile_room_mismatch",
            )
        participants = resolve_profile(profile) if profile else ()
        register_room_pane(
            state,
            workspace_id=workspace_id,
            pane_id=pane_id,
            tab_id=tab_id,
            room=room,
            operation_id=operation_id,
        )
        clean_stale_room_panes(herdr_bin, state, state_dir, state_path)
        if profile:
            reverify_profile_participants(
                herdr_bin,
                str(state.get("agents_workspace_id") or ""),
                str(state.get("agents_cwd") or ""),
                state,
                participants,
            )
        save_launcher_state(state_dir, state, state_path)
        agents_workspace_id = str(state.get("agents_workspace_id") or "")
    # Reopening a retained room must not replay a previous launch's setup failures.
    os.environ.pop(SETUP_FAILURES_ENV, None)
    executable = Path(__file__).resolve().parent / "herdr-group-chat"
    arguments = [str(executable), "--room", room]
    if agents_workspace_id:
        arguments.extend(["--agents-workspace", agents_workspace_id])
    if profile:
        profile_arguments, receipt = profile_room_exec(profile, participants)
        arguments.extend(profile_arguments)
        os.environ[PROFILE_RECEIPT_ENV] = receipt
    else:
        os.environ.pop(PROFILE_RECEIPT_ENV, None)
    os.execv(str(executable), arguments)
    return 0


def parse_launch_arguments(arguments: list[str]) -> tuple[str, str | None]:
    """Return (mode, profile) for the exact launcher argv; anything else fails."""
    if not arguments:
        return "setup", None
    mode = arguments[0]
    rest = arguments[1:]
    if mode == "--last-error":
        if rest:
            raise BootstrapError(f"unknown arguments: {' '.join(arguments)}")
        return "--last-error", None
    if mode == "--adopt-peers":
        if rest:
            raise BootstrapError(f"unknown arguments: {' '.join(arguments)}")
        return "--adopt-peers", None
    if mode == "--errors":
        try:
            count = int(rest[0])
        except (IndexError, ValueError):
            count = 0
        if len(rest) != 1 or count < 1:
            raise BootstrapError("--errors requires a positive record count")
        return "--errors", None
    profile: str | None = None
    if rest[:1] == ["--profile"]:
        if len(rest) < 2 or not rest[1]:
            raise BootstrapError("--profile requires a profile name")
        profile = rest[1]
        rest = rest[2:]
    if rest or mode not in {"--launch", "--open", "--adopt-peers", "--room-entrypoint"}:
        raise BootstrapError(f"unknown arguments: {' '.join(arguments)}")
    if profile is not None and mode != "--launch":
        raise BootstrapError("--profile only applies to --launch")
    return mode, profile


def run_launcher(arguments: list[str]) -> int:
    """Dispatch one invocation, recording every failure durably before exiting."""
    mode = "unknown"
    try:
        mode, profile = parse_launch_arguments(arguments)
        if mode == "--launch":
            return launch_room(open_existing=False, profile=profile)
        if mode == "--open":
            return launch_room(open_existing=True)
        if mode == "--adopt-peers":
            return adopt_stale_peers()
        if mode == "--room-entrypoint":
            return room_entrypoint()
        if mode == "--last-error":
            return show_launcher_errors(limit=1)
        if mode == "--errors":
            return show_launcher_errors(limit=int(arguments[1]))
        return main()
    except BootstrapError as error:
        print(f"new-room: {error}", file=sys.stderr)
        append_launcher_error(mode, arguments, error)
        hold_pane_open(mode)
        raise SystemExit(2) from error
    except Exception as error:
        traceback.print_exc()
        append_launcher_error(mode, arguments, error)
        hold_pane_open(mode)
        raise SystemExit(1) from error


if __name__ == "__main__":
    raise SystemExit(run_launcher(sys.argv[1:]))
