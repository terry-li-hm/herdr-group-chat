    """One bounded room participant: role, Herdr agent name, and native launch argv."""

    role: str
    kind: str
    name: str
    start_args: tuple[str, ...] = ()
    pane_proofs: tuple[tuple[tuple[str, ...], ...], ...] = ()
    # Reopen (re-verification) proofs: weaker bounded pane evidence plus exact
