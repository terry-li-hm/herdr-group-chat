def clean_stale_room_panes(
    herdr_bin: str,
    state: dict[str, Any],
    state_dir: Path | None = None,
    state_path: Path | None = None,
) -> None:
    remaining: list[str] = []
    for pane_id in dict.fromkeys(state.get("stale_room_pane_ids", [])):
        try:
            if state_dir is not None and state_path is not None:
                assert_server_identity(state_dir, state_path)
            run_json(herdr_bin, ["plugin", "pane", "close", pane_id])
        except BootstrapError as error:
            if error.code != "plugin_pane_not_found":
                remaining.append(pane_id)
    if remaining:
        state["stale_room_pane_ids"] = remaining
    else:
        state.pop("stale_room_pane_ids", None)


def close_tracked_tab(
    herdr_bin: str,
    state: dict[str, Any],
    state_field: str,
    tab_id: str | None,
    state_dir: Path | None = None,
    state_path: Path | None = None,
) -> None:
    if not tab_id:
        return
    try:
        if state_dir is not None and state_path is not None:
            assert_server_identity(state_dir, state_path)
        run_json(herdr_bin, ["tab", "close", tab_id])
    except BootstrapError as error:
        if error.code != "tab_not_found":
            return
    state.pop(state_field, None)


INDETERMINATE_OPEN_CODES = {"client_disconnected", "command_timeout", "server_unavailable"}
PENDING_ROOM_GRACE_MS = 60_000


def reconcile_pending_room(state: dict[str, Any]) -> None:
    if not state.get("pending_room_id"):
        return
    started = state.get("pending_room_started_unix_ms", 0)
    age_ms = int(time.time() * 1000) - started
    if age_ms < PENDING_ROOM_GRACE_MS:
        raise BootstrapError(
            "a previous room launch is still pending; try Open group chat again shortly",
            code="room_launch_pending",
        )
    state.pop("pending_room_id", None)
    state.pop("pending_room_operation_id", None)
    state.pop("pending_room_profile", None)
    state.pop("pending_room_started_unix_ms", None)


def register_room_pane(
    state: dict[str, Any],
    *,
    workspace_id: str,
    pane_id: str,
    tab_id: str,
    room: str,
    operation_id: str,
    consume_pending: bool = True,
) -> None:
    """Record room pane ownership.

    The inner entrypoint (default) consumes the matching pending operation so
    the launch is claimed complete. The outer launcher registers with
    ``consume_pending=False``: it records pane/tab ownership but retains the
    pending operation/profile so the inner process still observes them after
    it acquires the lock.
    """
    pending_operation = state.get("pending_room_operation_id")
    if pending_operation and pending_operation != operation_id:
        raise BootstrapError("this room launch was superseded by a newer operation")
    if not pending_operation and state.get("room_pane_id") not in {None, "", pane_id}:
        raise BootstrapError("this room launch is no longer current")
    previous_pane_id = state.get("room_pane_id")
    if previous_pane_id and previous_pane_id != pane_id:
        stale_panes = state.setdefault("stale_room_pane_ids", [])
        if previous_pane_id not in stale_panes:
            stale_panes.append(previous_pane_id)
    state.update(
        {
            "chat_workspace_id": workspace_id,
            "room_pane_id": pane_id,
            "room_tab_id": tab_id,
            "last_room_id": room,
        }
    )
    if not consume_pending:
        return
    state.pop("pending_room_id", None)
    state.pop("pending_room_operation_id", None)
    state.pop("pending_room_profile", None)
    state.pop("pending_room_started_unix_ms", None)


@dataclass(frozen=True)
class Settings:
    """Operator settings from the plugin config directory; every field has a default."""

    layout: str = "compact"
    opus: bool = False


def settings_path(plugin_id: str) -> Path:
    """Explicit override, then Herdr's config dir, then the XDG default location."""
    override = os.environ.get(SETTINGS_ENV, "").strip()
    if override:
        return Path(override)
    configured = os.environ.get("HERDR_PLUGIN_CONFIG_DIR", "").strip()
    if configured:
        return Path(configured) / SETTINGS_FILENAME
    base = os.environ.get("XDG_CONFIG_HOME", "").strip() or str(Path.home() / ".config")
    return Path(base) / "herdr" / "plugins" / "config" / plugin_id / SETTINGS_FILENAME


def load_settings(plugin_id: str) -> Settings:
    """Read settings.toml; a missing file means defaults, an invalid one fails closed."""
    path = settings_path(plugin_id)
    try:
        raw = path.read_bytes()
    except FileNotFoundError:
        return Settings()
    except OSError as error:
        raise BootstrapError(
            f"settings unreadable at {path}: {error}", code="settings_invalid"
        ) from error
    try:
        data = tomllib.loads(raw.decode("utf-8"))
    except (tomllib.TOMLDecodeError, UnicodeDecodeError) as error:
        raise BootstrapError(
            f"settings invalid at {path}: {error}", code="settings_invalid"
        ) from error
    unknown = sorted(set(data) - {"layout", "opus"})
    if unknown:
        raise BootstrapError(
            f"settings invalid at {path}: unknown keys {unknown}", code="settings_invalid"
        )
    layout = data.get("layout", "compact")
    if layout not in LAYOUTS:
        raise BootstrapError(
            f"settings invalid at {path}: layout must be one of {list(LAYOUTS)}",
            code="settings_invalid",
        )
    opus = data.get("opus", False)
    if not isinstance(opus, bool):
        raise BootstrapError(
            f"settings invalid at {path}: opus must be true or false", code="settings_invalid"
        )
    return Settings(layout=str(layout), opus=opus)


def apply_settings_profile(profile: str | None, settings: Settings) -> str | None:
    """Only the default profile gains Opus; every other profile is left exactly as asked."""
    if profile == DEFAULT_PROFILE and settings.opus:
        return OPUS_DEFAULT_PROFILE
    return profile


def focused_workspace_and_tab(herdr_bin: str) -> tuple[str, str]:
    listed = run_json(herdr_bin, ["workspace", "list"])
    for workspace in listed.get("result", {}).get("workspaces", []):
        if isinstance(workspace, dict) and workspace.get("focused"):
            return (
                str(workspace.get("workspace_id") or ""),
                str(workspace.get("active_tab_id") or ""),
            )
    return "", ""


def workspace_label_by_id(herdr_bin: str) -> dict[str, str]:
    """Live workspace labels by id, from `workspace list` alone."""
    return {
        str(workspace["workspace_id"]): str(workspace.get("label") or "")
        for workspace in workspaces(herdr_bin)
    }


def ensure_place_workspace(herdr_bin: str, cwd: str, label: str) -> str:
    """The live workspace carrying `label`, created unfocused when absent."""
    for workspace in workspaces(herdr_bin):
        if str(workspace.get("label")) == label:
            return str(workspace["workspace_id"])
    created = run_json(
        herdr_bin,
        ["workspace", "create", "--cwd", cwd, "--label", label, "--no-focus"],
        timeout=None,
    )
    return str(created["result"]["workspace"]["workspace_id"])


def grid_peer_split_ratios(participant_count: int) -> tuple[str, ...]:
    """Per-move `--ratio` values for the grid's `down` splits, equalizing the stack.

    Peer k (k from 2) splits the pane of peer k-1, and every earlier peer is
    split exactly once more, so for N peers to finish within one row of each
    other the target pane of the k-th move must keep 1/(N-k+2) of the pane
    being split — which is exactly the probed meaning of `--ratio`. The last
    move is therefore always 0.5, and with the observed 0.5 default the old
    fixed-halving stack (27/13/7/6 rows in a 53-row tab) becomes equal.
    """
    if participant_count < 2:
        return ()
    return tuple(
        format(1 / (participant_count - split), ".4f") for split in range(participant_count - 1)
    )


def place(
    herdr_bin: str,
    layout: str,
    state: dict[str, Any],
    participants: Sequence[Participant],
    room_pane_id: str,
    room_tab_id: str,
    room_workspace_id: str,
) -> list[str]:
    """Place every owned peer for `layout`, from live state only.

    The step reads `agent get` for each participant, `pane layout` for the
    room tab and `workspace list` for labels; no recorded pane, tab or
    workspace id is authority. It is idempotent: a peer already sitting
    where the layout puts it is never moved, so a re-run issues no command.
    `compact` moves each owned peer that is not in a workspace labelled
    `agents · group-chat` into that workspace (created on demand with
    `--no-focus`) as its own tab labelled `<role> · group-chat`. `grid`
    moves each owned peer that is not already in the room tab into it as
    the right-hand stack: the room pane is the split anchor, the first
    mover splits it `right` keeping GRID_ROOM_RATIO, and every later mover
    splits the previous mover `down` with its ratio from
    `grid_peer_split_ratios`, so the stack finishes with equal heights.
    The caller's focused workspace and tab are recorded before the first
    move and restored after the last. No workspace is ever closed.
    """
    if layout not in LAYOUTS:
        raise BootstrapError(f"unknown layout {layout!r}", code="settings_invalid")
    owned: list[tuple[Participant, dict[str, Any]]] = []
    for participant in participants:
        agent = owned_participant(herdr_bin, participant, str(state.get("agents_cwd") or ""))
        if agent is not None:
            owned.append((participant, agent))
    moved: list[str] = []
    caller_workspace, caller_tab = "", ""
    if layout == "compact":
        labels = workspace_label_by_id(herdr_bin)
        movers = [
            (participant, agent)
            for participant, agent in owned
            if labels.get(str(agent.get("workspace_id") or "")) != AGENTS_WORKSPACE_LABEL
        ]
        target_id = ""
        if movers:
            caller_workspace, caller_tab = focused_workspace_and_tab(herdr_bin)
        for participant, agent in movers:
            if not target_id:
                target_id = ensure_place_workspace(
                    herdr_bin, str(state.get("agents_cwd") or Path.cwd()), AGENTS_WORKSPACE_LABEL
                )
            run_json(
                herdr_bin,
                [
                    "pane",
                    "move",
                    str(agent["pane_id"]),
                    "--workspace",
                    target_id,
                    "--new-tab",
                    "--label",
                    f"{participant.role} · group-chat",
                ],
            )
            moved.append(participant.role)
    else:
        movers = [
            (participant, agent)
            for participant, agent in owned
            if str(agent.get("tab_id") or "") != room_tab_id
        ]
        if movers and not room_pane_id:
            raise BootstrapError(
                "grid placement needs a live room pane to anchor the stack",
                code="place_failed",
            )
        down_ratios = grid_peer_split_ratios(len(movers))
        anchor = room_pane_id
        if movers:
            caller_workspace, caller_tab = focused_workspace_and_tab(herdr_bin)
        for index, (participant, agent) in enumerate(movers):
            arguments = ["pane", "move", str(agent["pane_id"]), "--tab", room_tab_id, "--split"]
            if index == 0:
                arguments.extend(["right", "--target-pane", anchor, "--ratio", GRID_ROOM_RATIO])
            else:
                arguments.extend(
                    ["down", "--target-pane", anchor, "--ratio", down_ratios[index - 1]]
                )
            run_json(herdr_bin, arguments)
            anchor = str(agent["pane_id"])
            moved.append(participant.role)
    panes = state.setdefault("participant_pane_ids", {})
    tabs = state.setdefault("participant_tab_ids", {})
    verify_workspace = ""
    last_workspace = ""
    for participant, _agent in owned:
        live = (
            run_json(herdr_bin, ["agent", "get", participant.name])
            .get("result", {})
            .get("agent", {})
        )
        panes[participant.role] = str(live.get("pane_id") or "")
        tabs[participant.role] = str(live.get("tab_id") or "")
        last_workspace = str(live.get("workspace_id") or "")
        if layout == "compact":
            if not verify_workspace:
                verify_workspace = workspace_label_by_id(herdr_bin)
            if verify_workspace.get(str(live.get("workspace_id") or "")) != AGENTS_WORKSPACE_LABEL:
                raise BootstrapError(
                    f"@{participant.role}: {participant.name} did not land in "
                    f"{AGENTS_WORKSPACE_LABEL}",
                    code="place_failed",
                )
        elif str(live.get("tab_id") or "") != room_tab_id:
            raise BootstrapError(
                f"@{participant.role}: {participant.name} did not land in the room tab",
                code="place_failed",
            )
    state["layout"] = layout
    state["participant_workspace_id"] = last_workspace
    for arguments in (
        ["workspace", "focus", caller_workspace] if caller_workspace else None,
        ["tab", "focus", caller_tab] if caller_tab else None,
    ):
        if arguments is None:
            continue
        try:
            run_json(herdr_bin, arguments)
        except BootstrapError as error:
            # The caller's workspace or tab may itself have vanished while the
            # moves ran; Herdr owns the lifecycle, so "already gone" is fine.
            if error.code not in {"workspace_not_found", "tab_not_found"}:
                raise
    return moved


def launch_room(open_existing: bool, profile: str | None = None) -> int:
    if profile and open_existing:
        # Opening the retained room never selects a profile; the stored binding wins.
        raise BootstrapError("--profile only applies to a new room launch")
    resolve_profile(profile)  # unknown profiles fail before opening tabs
    herdr_bin = os.environ.get("HERDR_BIN_PATH", "herdr")
    settings = load_settings(os.environ.get("HERDR_PLUGIN_ID", "terry.herdr-group-chat"))
    if profile and not open_existing:
        profile = apply_settings_profile(profile, settings)
        resolve_profile(profile)
    context = plugin_context()
    cwd = str(context.get("focused_pane_cwd") or context.get("workspace_cwd") or Path.cwd())
    state_dir = plugin_state_dir()
    with launcher_state_lock(state_dir) as state_path:
        state = load_launcher_state(state_dir, state_path)
        reconcile_pending_room(state)
        save_launcher_state(state_dir, state, state_path)
        state = load_validated_launcher_state(state_dir, herdr_bin, state_path)
        close_tracked_tab(
            herdr_bin,
            state,
            "chat_placeholder_tab_id",
            state.get("chat_placeholder_tab_id"),
            state_dir,
            state_path,
        )
        close_tracked_tab(
            herdr_bin,
            state,
            "agents_placeholder_tab_id",
            state.get("agents_placeholder_tab_id"),
            state_dir,
            state_path,
        )
        clean_stale_room_panes(herdr_bin, state, state_dir, state_path)
        save_launcher_state(state_dir, state, state_path)

        previous_pane_id = state.get("room_pane_id")
        if open_existing and previous_pane_id:
            try:
                assert_server_identity(state_dir, state_path)
                response = run_json(herdr_bin, ["plugin", "pane", "focus", previous_pane_id])
            except BootstrapError as error:
                if error.code != "plugin_pane_not_found":
                    raise
                state.pop("room_pane_id", None)
                state.pop("room_tab_id", None)
                save_launcher_state(state_dir, state, state_path)
            else:
                print(json.dumps(response, separators=(",", ":")))
                return 0

        workspace_id, placeholder_tab_id = ensure_chat_workspace(
            herdr_bin, cwd, state_dir, state, state_path
        )
        save_launcher_state(state_dir, state, state_path)

        plugin_id = os.environ.get("HERDR_PLUGIN_ID", "terry.herdr-group-chat")
        entrypoint = "room" if open_existing else "new-room"
        room = state.get("last_room_id", "cockpit") if open_existing else new_room_id()
        operation_id = uuid.uuid4().hex
        pane_arguments = [
            "plugin",
            "pane",
            "open",
            "--plugin",
            plugin_id,
            "--entrypoint",
            entrypoint,
            "--placement",
            "tab",
            "--workspace",
            workspace_id,
            "--env",
            f"{ROOM_ENV}={room}",
            "--env",
            f"{AGENT_CWD_ENV}={cwd}",
            "--env",
            f"{ROOM_OPERATION_ENV}={operation_id}",
        ]
        if profile:
            pane_arguments.extend(["--env", f"{PROFILE_ENV}={profile}"])
        if not open_existing:
            pane_arguments.extend(["--env", f"{LAYOUT_ENV}={settings.layout}"])
        agents_workspace_id = state.get("agents_workspace_id")
        if agents_workspace_id and agents_workspace_id in workspace_ids(herdr_bin):
            pane_arguments.extend(["--env", f"{AGENTS_WORKSPACE_ENV}={agents_workspace_id}"])
        # A fresh launch must never steal the caller's focus: neither the room
        # pane nor either workspace takes it. The explicit Open group chat action
        # is focus-oriented, so recreating a missing room pane may use --focus.
        pane_arguments.append("--focus" if open_existing else "--no-focus")
        state["pending_room_id"] = room
        state["pending_room_operation_id"] = operation_id
        if profile:
            state["pending_room_profile"] = profile
        state["pending_room_started_unix_ms"] = int(time.time() * 1000)
        save_launcher_state(state_dir, state, state_path)
        try:
            assert_server_identity(state_dir, state_path)
            response = run_json(herdr_bin, pane_arguments, timeout=None)
        except BootstrapError as error:
            if error.code not in INDETERMINATE_OPEN_CODES:
                state.pop("pending_room_id", None)
                state.pop("pending_room_operation_id", None)
                state.pop("pending_room_profile", None)
                state.pop("pending_room_started_unix_ms", None)
                save_launcher_state(state_dir, state, state_path)
            raise
        pane = response["result"]["plugin_pane"]["pane"]
        pane_id = str(pane["pane_id"])
        tab_id = str(pane["tab_id"])
        register_room_pane(
            state,
            workspace_id=workspace_id,
            pane_id=pane_id,
            tab_id=tab_id,
            room=room,
            operation_id=operation_id,
            consume_pending=False,
        )
        save_launcher_state(state_dir, state, state_path)
        assert_server_identity(state_dir, state_path)
        run_json(herdr_bin, ["tab", "rename", tab_id, "group-chat"])
        close_tracked_tab(
            herdr_bin,
            state,
            "chat_placeholder_tab_id",
            placeholder_tab_id,
            state_dir,
            state_path,
        )
        clean_stale_room_panes(herdr_bin, state, state_dir, state_path)
        save_launcher_state(state_dir, state, state_path)
    print(json.dumps(response, separators=(",", ":")))
    return 0


def same_cwd(left: str, right: str) -> bool:
    return Path(left).expanduser().resolve() == Path(right).expanduser().resolve()


def owned_participant(
    herdr_bin: str, participant: Participant, agent_cwd: str
) -> dict[str, Any] | None:
    """The live `agent get` record when the participant is owned; None otherwise.

    Ownership is by name only: the agent exists, its kind matches the
    participant, and its cwd matches the room's agent cwd. Fresh launch,
    reopen and adopt all reduce to this single check; no recorded pane, tab
    or workspace id ever takes part.
    """
    try:
        live = run_json(herdr_bin, ["agent", "get", participant.name])
    except BootstrapError as error:
        if error.code == "agent_not_found":
            return None
        raise
    agent = live.get("result", {}).get("agent")
    if not isinstance(agent, dict) or not agent:
        return None
    if not live_agent_kind_matches(agent, participant.kind):
        return None
    live_cwd = str(agent.get("cwd") or agent.get("foreground_cwd") or "")
    if not live_cwd or not same_cwd(live_cwd, agent_cwd):
        return None
    return agent


def live_agent_unowned_reason(
    live_agent: Mapping[str, Any], participant: Participant, agent_cwd: str
) -> str:
    """Why a live same-named agent is not owned; display text only, never authority."""
    if not live_agent_kind_matches(live_agent, participant.kind):
        return "a different agent kind"
    return f"cwd {live_agent.get('cwd') or live_agent.get('foreground_cwd')}, not {agent_cwd}"


def blocked_startup_prompt_guidance(participant: Participant) -> str:
    """Explain how to resume a native startup prompt without answering it."""
    product = {"claude": "Claude", "codex": "Codex"}.get(participant.kind, participant.kind)
    return (
        f"@{participant.role}: {product} is waiting at a blocked startup prompt in the "
        "preserved tab; answer the prompt there, then rerun group-chat setup"
    )


def blocked_pending_participant_tab_exists(
    herdr_bin: str, agents_workspace_id: str, pending: object
) -> bool:
    """Return whether the exact blocked-startup tab remains in the owned workspace."""
    if not isinstance(pending, dict) or pending.get("blocked_startup") is not True:
        return False
    tab_id = pending.get("tab_id")
    pane_id = pending.get("pane_id")
    if not isinstance(tab_id, str) or not tab_id or not isinstance(pane_id, str) or not pane_id:
        return False
    try:
        listed = run_json(herdr_bin, ["tab", "list", "--workspace", agents_workspace_id])
    except BootstrapError as error:
        if error.code != "workspace_not_found":
            raise
        return False
    for tab in listed.get("result", {}).get("tabs", []):
        if not isinstance(tab, dict) or tab.get("tab_id") != tab_id:
            continue
        if "workspace_id" in tab and str(tab["workspace_id"]) != agents_workspace_id:
            continue
        root_pane = tab.get("root_pane")
        listed_pane_id = tab.get("pane_id") or tab.get("root_pane_id")
        if isinstance(root_pane, dict):
            listed_pane_id = listed_pane_id or root_pane.get("pane_id")
        return listed_pane_id is None or (
            isinstance(listed_pane_id, str) and listed_pane_id == pane_id
        )
    return False


def infer_owned_agents_cwd(herdr_bin: str, requested_cwd: str) -> str:
    """Reuse the live peers' cwd when every configured live peer shares one."""
    listed = run_json(herdr_bin, ["agent", "list"])
    expected_names = {name for _, name in PARTICIPANTS} | {
        participant.name
        for participants in PROFILE_PARTICIPANTS.values()
        for participant in participants
    }
    owned_cwds = {
        str(item.get("cwd") or item.get("foreground_cwd"))
        for item in listed.get("result", {}).get("agents", [])
        if isinstance(item, dict)
        and item.get("name") in expected_names
        and (item.get("cwd") or item.get("foreground_cwd"))
    }
    return owned_cwds.pop() if len(owned_cwds) == 1 else requested_cwd


def close_pending_participant_tab(
    herdr_bin: str,
    agents_workspace_id: str,
    pending: dict[str, Any],
    state_dir: Path,
    state_path: Path,
) -> None:
    tab_id = pending.get("tab_id")
    if not tab_id and pending.get("label"):
        try:
            listed = run_json(herdr_bin, ["tab", "list", "--workspace", agents_workspace_id])
        except BootstrapError as error:
            # Herdr auto-closes an emptied workspace; with it gone there is no
            # pending tab left to close.
            if error.code != "workspace_not_found":
                raise
            return
        matches = [
            tab
            for tab in listed.get("result", {}).get("tabs", [])
            if isinstance(tab, dict) and tab.get("label") == pending["label"]
        ]
        if len(matches) == 1:
            tab_id = matches[0].get("tab_id")
    if tab_id:
        assert_server_identity(state_dir, state_path)
        try:
            run_json(herdr_bin, ["tab", "close", str(tab_id)])
        except BootstrapError as error:
            if error.code != "tab_not_found":
                raise


def close_recorded_participant(
    herdr_bin: str,
    pane_id: str,
    tab_id: str | None,
    state_dir: Path,
    state_path: Path,
) -> None:
    assert_server_identity(state_dir, state_path)
    arguments = ["tab", "close", tab_id] if tab_id else ["pane", "close", pane_id]
    try:
        run_json(herdr_bin, arguments)
    except BootstrapError as error:
        if error.code not in {"tab_not_found", "pane_not_found"}:
            raise


def start_participants(
    herdr_bin: str,
    agent_cwd: str,
    agents_workspace_id: str,
    state_dir: Path,
    state_path: Path,
    state: dict[str, Any],
    participants: Sequence[Participant] | None = None,
) -> tuple[list[str], list[Participant]]:
    """Start (or re-verify) the requested participants, returning setup failures.

    Exactly one participant is recorded per role: the same exact named
    participant is reused, while a different requested name for a recorded role
    intentionally closes the plugin-recorded tab before starting its
    replacement. Only participants whose native host evidence verified become
    routable; a live session under the requested name that mismatches its kind,
    ownership, or native evidence is excluded without being closed.
    """
    if participants is None:
        participants = resolve_profile(None)
    listed = run_json(herdr_bin, ["agent", "list"])
    agents = listed.get("result", {}).get("agents", [])
    live_agents = {
        item["name"]: item for item in agents if isinstance(item, dict) and item.get("name")
    }

    failures: list[str] = []
    participant_panes = state.setdefault("participant_pane_ids", {})
    participant_tabs = state.setdefault("participant_tab_ids", {})
    pending_tabs = state.setdefault("pending_participant_tabs", {})
    for participant in participants:
        role = participant.role
        name = participant.name
        live_agent = live_agents.get(name)
        if live_agent is not None:
            owned = owned_participant(herdr_bin, participant, agent_cwd)
            if owned is None:
                reason = live_agent_unowned_reason(live_agent, participant, agent_cwd)
                failures.append(
                    f"@{role}: {name} is live but not owned ({reason}); the session was left open"
                )
                print(f"failed @{role}", flush=True)
                continue
            if needs_native_proof(participant) and not (
                catalog_proof(participant)
                and participant_process_proves(herdr_bin, participant, str(owned["pane_id"]))
            ):
                pending = pending_tabs.get(role)
                if isinstance(pending, dict) and pending.get("blocked_startup") is True:
                    failures.append(blocked_startup_prompt_guidance(participant))
                    print(f"pending @{role} trust", flush=True)
                    continue
                failures.append(
                    f"@{role}: {name} failed process verification; the session was left open"
                )
                print(f"unverified @{role}", flush=True)
                continue
            participant_panes[role] = str(owned["pane_id"])
            participant_tabs[role] = str(owned["tab_id"])
            pending = pending_tabs.get(role)
            if pending is not None and pending.get("tab_id") != owned.get("tab_id"):
                # A stale pending tab from an interrupted start is closed only
                # when it is not the live peer's own tab.
                try:
                    close_pending_participant_tab(
                        herdr_bin, agents_workspace_id, pending, state_dir, state_path
                    )
                except BootstrapError as error:
                    failures.append(f"@{role}: pending-tab cleanup failed: {error}")
                    print(f"cleanup @{role} pending", flush=True)
                    save_launcher_state(state_dir, state, state_path)
                    continue
            if pending is not None:
                pending_tabs.pop(role, None)
            save_launcher_state(state_dir, state, state_path)
            print(f"ready  @{role} (existing {name})", flush=True)
            continue
        print(f"start  @{role}", flush=True)
        recorded_pane_id = participant_panes.get(role)
        if recorded_pane_id:
            # One recorded participant per role: a different requested name
            # replaces the recorded occupant. The replacement is announced only
            # once its plugin-recorded tab has actually closed, so a failed
            # close reports `cleanup @role previous` instead.
            try:
                close_recorded_participant(
                    herdr_bin,
                    recorded_pane_id,
                    participant_tabs.get(role),
                    state_dir,
                    state_path,
                )
            except BootstrapError as error:
                failures.append(f"@{role}: previous-tab cleanup failed: {error}")
                print(f"cleanup @{role} previous", flush=True)
                continue
            print(f"replace @{role}", flush=True)
            participant_panes.pop(role, None)
            participant_tabs.pop(role, None)
            save_launcher_state(state_dir, state, state_path)
        pending = pending_tabs.get(role)
        if pending:
            if pending.get("blocked_startup") is True:
                try:
                    blocked_tab_exists = blocked_pending_participant_tab_exists(
                        herdr_bin, agents_workspace_id, pending
                    )
                except BootstrapError as error:
                    failures.append(f"@{role}: blocked-startup tab check failed: {error}")
                    print(f"blocked @{role} check", flush=True)
                    continue
                if blocked_tab_exists:
                    failures.append(blocked_startup_prompt_guidance(participant))
                    print(f"pending @{role} trust", flush=True)
                    continue
                pending_tabs.pop(role, None)
                save_launcher_state(state_dir, state, state_path)
                pending = None
            if pending:
                age_ms = int(time.time() * 1000) - int(pending.get("started_unix_ms", 0))
                if age_ms < PENDING_ROOM_GRACE_MS:
                    failures.append(f"@{role}: previous agent start is still pending")
                    print(f"pending @{role}", flush=True)
                    continue
                try:
                    close_pending_participant_tab(
                        herdr_bin, agents_workspace_id, pending, state_dir, state_path
                    )
                except BootstrapError as error:
                    failures.append(f"@{role}: pending-tab cleanup failed: {error}")
                    print(f"cleanup @{role} pending", flush=True)
                    continue
                pending_tabs.pop(role, None)
                save_launcher_state(state_dir, state, state_path)
        try:
            if not catalog_proof(participant):
                failures.append(
                    f"@{role}: {name} failed the native catalog preflight; no tab was created"
                )
                print(f"unverified @{role} (catalog)", flush=True)
                continue
            pending_label = f"hgchat-{role}-{uuid.uuid4().hex[:10]}"
            pending_tabs[role] = {
                "label": pending_label,
                "started_unix_ms": int(time.time() * 1000),
            }
            save_launcher_state(state_dir, state, state_path)
            assert_server_identity(state_dir, state_path)
            created = run_json(
                herdr_bin,
                [
                    "tab",
                    "create",
                    "--workspace",
                    agents_workspace_id,
                    "--cwd",
                    agent_cwd,
                    "--label",
                    pending_label,
                    *participant_tab_env(participant),
                    "--no-focus",
                ],
                timeout=None,
            )
            pane_id = str(created["result"]["root_pane"]["pane_id"])
            participant_tab_id = str(created["result"]["tab"]["tab_id"])
            pending_tabs[role] = {
                "label": pending_label,
                "pane_id": pane_id,
                "tab_id": participant_tab_id,
                "started_unix_ms": int(time.time() * 1000),
            }
            save_launcher_state(state_dir, state, state_path)
            wait_for_shell(herdr_bin, pane_id)
            assert_server_identity(state_dir, state_path)
            start_agent(herdr_bin, name, participant.kind, pane_id, participant.start_args)
            if needs_native_proof(participant) and not participant_process_proves(
                herdr_bin, participant, pane_id
            ):
                try:
                    close_pending_participant_tab(
                        herdr_bin, agents_workspace_id, pending_tabs[role], state_dir, state_path
                    )
                except BootstrapError as cleanup_error:
                    failures.append(f"@{role}: pending-tab cleanup failed: {cleanup_error}")
                else:
                    pending_tabs.pop(role, None)
                participant_panes.pop(role, None)
                participant_tabs.pop(role, None)
                save_launcher_state(state_dir, state, state_path)
                failures.append(
                    f"@{role}: {name} failed process verification; the new tab was closed"
                )
                print(f"unverified @{role}", flush=True)
                continue
            participant_panes[role] = pane_id
            participant_tabs[role] = participant_tab_id
            pending_tabs.pop(role, None)
            save_launcher_state(state_dir, state, state_path)
            with suppress(BootstrapError):
                assert_server_identity(state_dir, state_path)
                run_json(
                    herdr_bin,
                    ["tab", "rename", participant_tab_id, f"{role} · group-chat"],
                )
            if participant.kind == "codex":
                with suppress(BootstrapError):
                    assert_server_identity(state_dir, state_path)
                    dismiss_inactive_hook_notice(herdr_bin, name, pane_id)
            print(f"ready  @{role}", flush=True)
        except (BootstrapError, KeyError, TypeError) as error:
            if isinstance(error, BootstrapError) and error.code == "agent_not_ready":
                # Herdr has started the native agent but it is blocked in its
                # own trust UI. Preserve the recorded pane/tab so a later
                # setup retry can prove and promote that exact surface.
                pending_tabs[role]["blocked_startup"] = True
                save_launcher_state(state_dir, state, state_path)
                failures.append(blocked_startup_prompt_guidance(participant))
                print(f"pending @{role} trust", flush=True)
                continue
            if not isinstance(error, BootstrapError) or error.code not in INDETERMINATE_OPEN_CODES:
                pending = pending_tabs.get(role)
                if pending:
                    try:
                        close_pending_participant_tab(
                            herdr_bin,
                            agents_workspace_id,
                            pending,
                            state_dir,
                            state_path,
                        )
                    except BootstrapError as cleanup_error:
                        failures.append(f"@{role}: pending-tab cleanup failed: {cleanup_error}")
                    else:
                        pending_tabs.pop(role, None)
                save_launcher_state(state_dir, state, state_path)
            failures.append(f"@{role}: {error}")
            print(f"failed @{role}", flush=True)
    if not participant_panes:
        state.pop("participant_pane_ids", None)
    if not participant_tabs:
        state.pop("participant_tab_ids", None)
    if not pending_tabs:
        state.pop("pending_participant_tabs", None)
    save_launcher_state(state_dir, state, state_path)
    return failures


def all_configured_participants() -> tuple[Participant, ...]:
    """Every configured participant — classic set plus every profile — name-unique."""
    configured = [
        *resolve_profile(None),
        *(
            participant
            for participants in PROFILE_PARTICIPANTS.values()
            for participant in participants
        ),
    ]
    seen: set[str] = set()
    unique: list[Participant] = []
    for participant in configured:
        if participant.name not in seen:
            seen.add(participant.name)
            unique.append(participant)
    return tuple(unique)


def adopt_stale_peers() -> int:
    """Run the owned check for every configured role and report which are owned.

    Ownership is `owned_participant` alone, evaluated against the recorded
    room cwd (or the caller's cwd when no room cwd is recorded). Nothing is
    closed, prompted, or moved; owned roles are recorded as display caches
    and reported, everything else is reported as not owned.
    """
    herdr_bin = os.environ.get("HERDR_BIN_PATH", "herdr")
    state_dir = plugin_state_dir()
    with launcher_state_lock(state_dir) as state_path:
        state = load_launcher_state(state_dir, state_path)
        context = plugin_context()
        agent_cwd = str(state.get("agents_cwd") or "").strip() or str(
            context.get("focused_pane_cwd") or context.get("workspace_cwd") or Path.cwd()
        )
        listed = run_json(herdr_bin, ["agent", "list"])
        live_agents = {
            item["name"]: item
            for item in listed.get("result", {}).get("agents", [])
            if isinstance(item, dict) and item.get("name")
        }
        owned_roles: list[tuple[Participant, dict[str, Any]]] = []
        for participant in all_configured_participants():
            owned = owned_participant(herdr_bin, participant, agent_cwd)
            if owned is None:
                live = live_agents.get(participant.name)
                if live is None:
                    reason = "not live"
                else:
                    reason = live_agent_unowned_reason(live, participant, agent_cwd)
                print(
                    f"not owned @{participant.role} ({participant.name}): {reason}",
                    flush=True,
                )
                continue
            owned_roles.append((participant, owned))
            print(
                f"owned @{participant.role} ({participant.name}, pane {owned['pane_id']})",
                flush=True,
            )
        if not owned_roles:
            print(
                f"no configured group-chat participant is owned at cwd {agent_cwd}",
                flush=True,
            )
            return 0
        participant_panes = state.setdefault("participant_pane_ids", {})
        participant_tabs = state.setdefault("participant_tab_ids", {})
        for participant, owned in owned_roles:
            participant_panes[participant.role] = str(owned["pane_id"])
            participant_tabs[participant.role] = str(owned["tab_id"])
        state["agents_cwd"] = agent_cwd
        save_launcher_state(state_dir, state, state_path)
        print(
            f"{len(owned_roles)} peers owned at cwd {agent_cwd}",
            flush=True,
        )
    return 0


def main() -> int:
    herdr_bin = os.environ.get("HERDR_BIN_PATH", "herdr")
    profile = os.environ.get(PROFILE_ENV, "").strip() or None
    participants = resolve_profile(profile)  # unknown profiles fail before any tab opens
    workspace_id = os.environ.get("HERDR_WORKSPACE_ID", "").strip()
    tab_id = os.environ.get("HERDR_TAB_ID", "").strip()
    if not workspace_id:
        raise BootstrapError("New group chat must run inside a Herdr workspace")

    context = plugin_context()
    requested_agent_cwd = os.environ.get(AGENT_CWD_ENV, "").strip() or str(
        context.get("focused_pane_cwd") or context.get("workspace_cwd") or Path.cwd()
    )
    state_dir = plugin_state_dir()
    pane_id = os.environ.get("HERDR_PANE_ID", "").strip()
    operation_id = os.environ.get(ROOM_OPERATION_ENV, "").strip()
    room = os.environ.get(ROOM_ENV, "").strip() or new_room_id()
    if not pane_id or not tab_id or not operation_id:
        raise BootstrapError("New group chat is missing its Herdr pane context")
    with launcher_state_lock(state_dir) as state_path:
        state = load_launcher_state(state_dir, state_path)
        if profile is not None and (
            state.get("pending_room_operation_id") != operation_id
            or state.get("pending_room_profile") != profile
        ):
            raise BootstrapError(
                "room profile was not tied to this launch operation; retry the action",
                code="profile_operation_mismatch",
            )
        register_room_pane(
            state,
            workspace_id=workspace_id,
            pane_id=pane_id,
            tab_id=tab_id,
            room=room,
            operation_id=operation_id,
        )
        agent_cwd = str(state.get("agents_cwd") or "")
        if not agent_cwd:
            agent_cwd = infer_owned_agents_cwd(herdr_bin, requested_agent_cwd)
            state["agents_cwd"] = agent_cwd
        agents_workspace_id, placeholder_tab_id = ensure_agents_workspace(
            herdr_bin, agent_cwd, state_dir, state, state_path
        )
        save_launcher_state(state_dir, state, state_path)

        failures = start_participants(
            herdr_bin,
            agent_cwd,
            agents_workspace_id,
            state_dir,
            state_path,
            state,
            participants=participants,
        )

        if profile is not None and failures:
            # A profile room is atomic: it never opens with zero or one role.
            state.pop("selected_profile", None)
            save_launcher_state(state_dir, state, state_path)
            raise BootstrapError(
                f"the {profile} profile requires every participant to verify "
                "native evidence; the room was not opened:\n"
                + "\n".join(f"- {failure}" for failure in failures),
                code="profile_incomplete",
                failures=failures,
            )
        layout = os.environ.get(LAYOUT_ENV, "").strip() or "compact"
        if layout not in LAYOUTS:
            raise BootstrapError(f"unknown layout {layout!r}", code="settings_invalid")
        if not failures:
            place(
                herdr_bin,
                layout,
                state,
                participants,
                os.environ.get("HERDR_PANE_ID", "").strip(),
                os.environ.get("HERDR_TAB_ID", "").strip(),
                workspace_id,
            )
        else:
            state["layout"] = layout
        if profile:
            # Trust the profile only for this room, whose id lands in last_room_id.
            state["selected_profile"] = profile
        else:
            state.pop("selected_profile", None)
        save_launcher_state(state_dir, state, state_path)

        close_tracked_tab(
            herdr_bin,
            state,
            "agents_placeholder_tab_id",
            placeholder_tab_id,
            state_dir,
            state_path,
        )
        if tab_id:
            with suppress(BootstrapError):
                assert_server_identity(state_dir, state_path)
                run_json(herdr_bin, ["tab", "rename", tab_id, "group-chat"])
        clean_stale_room_panes(herdr_bin, state, state_dir, state_path)
        save_launcher_state(state_dir, state, state_path)

    if failures:
        print("\nUnavailable participants:", flush=True)
        for failure in failures:
            print(f"- {failure}", flush=True)
        print("\nOpening the room with the available peers...", flush=True)
    else:
        print("\nAll participants ready. Opening the room...", flush=True)

    # Hand the failures to the room process so they survive the setup pane's
    # redraw; a launch without failures must never show a previous launch's.
    if failures:
        os.environ[SETUP_FAILURES_ENV] = "\n".join(
            failure.replace("\n", " ") for failure in failures
        )
    else:
        os.environ.pop(SETUP_FAILURES_ENV, None)

    executable = Path(__file__).resolve().parent / "herdr-group-chat"
    arguments = [str(executable), "--room", room]
    if layout != "grid" or agents_workspace_id in workspace_ids(herdr_bin):
        arguments.extend(["--agents-workspace", agents_workspace_id])
    if profile:
        profile_arguments, receipt = profile_room_exec(profile, participants)
        arguments.extend(profile_arguments)
        os.environ[PROFILE_RECEIPT_ENV] = receipt
    else:
        os.environ.pop(PROFILE_RECEIPT_ENV, None)
    os.execv(
        str(executable),
        arguments,
    )


def reverify_profile_participants(
    herdr_bin: str,
    agents_cwd: str,
    participants: Sequence[Participant],
) -> None:
    """Re-verify each role against its exact live agent and native evidence.

    Ownership is the single `owned_participant` check; no recorded pane, tab
    or workspace id takes part. Never starts or closes anything, and any
    mismatch stops the reopen before exec.
    """
    if not agents_cwd:
        raise BootstrapError(
            "room profile re-verification is missing the agents cwd",
            code="profile_reverify_failed",
        )
    for participant in participants:
        owned = owned_participant(herdr_bin, participant, agents_cwd)
        if owned is None or not (
            catalog_proof(participant)
            and participant_process_proves(herdr_bin, participant, str(owned["pane_id"]))
        ):
            raise BootstrapError(
                f"@{participant.role}: {participant.name} failed room profile re-verification; "
                "the room was not reopened",
                code="profile_reverify_failed",
            )


def room_entrypoint() -> int:
    herdr_bin = os.environ.get("HERDR_BIN_PATH", "herdr")
    workspace_id = os.environ.get("HERDR_WORKSPACE_ID", "").strip()
    pane_id = os.environ.get("HERDR_PANE_ID", "").strip()
    tab_id = os.environ.get("HERDR_TAB_ID", "").strip()
    operation_id = os.environ.get(ROOM_OPERATION_ENV, "").strip()
    room = os.environ.get(ROOM_ENV, "").strip()
    if not all((workspace_id, pane_id, tab_id, operation_id, room)):
        raise BootstrapError("Group chat is missing its Herdr pane context")
    state_dir = plugin_state_dir()
    with launcher_state_lock(state_dir) as state_path:
        state = load_launcher_state(state_dir, state_path)
        # The profile is trusted only for the single retained room: the stored
        # binding is last_room_id, so a stale cross-room profile is rejected
        # before registration could rewrite it.
        profile = str(state.get("selected_profile") or "") or None
        if profile is not None and state.get("last_room_id") != room:
            raise BootstrapError(
                "stored room profile is bound to a different room; the room was "
                "not reopened as a profile room",
                code="profile_room_mismatch",
            )
        participants = resolve_profile(profile) if profile else ()
        register_room_pane(
            state,
            workspace_id=workspace_id,
            pane_id=pane_id,
            tab_id=tab_id,
            room=room,
            operation_id=operation_id,
        )
        clean_stale_room_panes(herdr_bin, state, state_dir, state_path)
        if profile:
            reverify_profile_participants(
                herdr_bin,
                str(state.get("agents_cwd") or ""),
                participants,
            )
        layout = str(state.get("layout") or "compact")
        if layout in LAYOUTS:
            place(
                herdr_bin,
                layout,
                state,
                participants if profile else resolve_profile(None),
                pane_id,
                tab_id,
                workspace_id,
            )
        save_launcher_state(state_dir, state, state_path)
        agents_workspace_id = str(state.get("agents_workspace_id") or "")
        if state.get("layout") == "grid" and agents_workspace_id not in workspace_ids(herdr_bin):
            agents_workspace_id = ""
    # Reopening a retained room must not replay a previous launch's setup failures.
    os.environ.pop(SETUP_FAILURES_ENV, None)
    executable = Path(__file__).resolve().parent / "herdr-group-chat"
    arguments = [str(executable), "--room", room]
    if agents_workspace_id:
        arguments.extend(["--agents-workspace", agents_workspace_id])
    if profile:
        profile_arguments, receipt = profile_room_exec(profile, participants)
        arguments.extend(profile_arguments)
        os.environ[PROFILE_RECEIPT_ENV] = receipt
    else:
        os.environ.pop(PROFILE_RECEIPT_ENV, None)
    os.execv(str(executable), arguments)
    return 0


def place_layout(layout: str) -> int:
    """Run `place` for a recorded room and print exactly one JSON result line."""
    herdr_bin = os.environ.get("HERDR_BIN_PATH", "herdr")
    if layout not in LAYOUTS:
        raise BootstrapError(f"--place requires one of {list(LAYOUTS)}", code="settings_invalid")
    state_dir = plugin_state_dir()
    with launcher_state_lock(state_dir) as state_path:
        state = load_launcher_state(state_dir, state_path)
        profile = str(state.get("selected_profile") or "") or None
        participants = resolve_profile(profile) if profile else resolve_profile(None)
        moved = place(
            herdr_bin,
            layout,
            state,
            participants,
            str(state.get("room_pane_id") or ""),
            str(state.get("room_tab_id") or ""),
            str(state.get("chat_workspace_id") or ""),
        )
        save_launcher_state(state_dir, state, state_path)
    print(
        json.dumps({"layout": layout, "moved": moved}, sort_keys=True, separators=(",", ":")),
        flush=True,
    )
    return 0


def parse_launch_arguments(arguments: list[str]) -> tuple[str, str | None]:
    """Return (mode, profile) for the exact launcher argv; anything else fails."""
    if not arguments:
        return "setup", None
    mode = arguments[0]
    rest = arguments[1:]
    if mode == "--last-error":
        if rest:
            raise BootstrapError(f"unknown arguments: {' '.join(arguments)}")
        return "--last-error", None
    if mode == "--adopt-peers":
        if rest:
            raise BootstrapError(f"unknown arguments: {' '.join(arguments)}")
        return "--adopt-peers", None
    if mode == "--place":
        if len(rest) != 1 or rest[0] not in LAYOUTS:
            raise BootstrapError("--place requires exactly one layout: compact or grid")
        return "--place", None
    if mode == "--errors":
        try:
            count = int(rest[0])
        except (IndexError, ValueError):
            count = 0
        if len(rest) != 1 or count < 1:
            raise BootstrapError("--errors requires a positive record count")
        return "--errors", None
    profile: str | None = None
    if rest[:1] == ["--profile"]:
        if len(rest) < 2 or not rest[1]:
            raise BootstrapError("--profile requires a profile name")
        profile = rest[1]
        rest = rest[2:]
    if rest or mode not in {"--launch", "--open", "--adopt-peers", "--place", "--room-entrypoint"}:
        raise BootstrapError(f"unknown arguments: {' '.join(arguments)}")
    if profile is not None and mode != "--launch":
        raise BootstrapError("--profile only applies to --launch")
    return mode, profile


def run_launcher(arguments: list[str]) -> int:
    """Dispatch one invocation, recording every failure durably before exiting."""
    mode = "unknown"
    try:
        mode, profile = parse_launch_arguments(arguments)
        if mode == "--launch":
            return launch_room(open_existing=False, profile=profile)
        if mode == "--open":
            return launch_room(open_existing=True)
        if mode == "--adopt-peers":
            return adopt_stale_peers()
        if mode == "--place":
            return place_layout(arguments[1])
        if mode == "--room-entrypoint":
            return room_entrypoint()
        if mode == "--last-error":
            return show_launcher_errors(limit=1)
        if mode == "--errors":
            return show_launcher_errors(limit=int(arguments[1]))
        return main()
    except BootstrapError as error:
        print(f"new-room: {error}", file=sys.stderr)
        append_launcher_error(mode, arguments, error)
        hold_pane_open(mode)
        raise SystemExit(2) from error
    except Exception as error:
        traceback.print_exc()
        append_launcher_error(mode, arguments, error)
        hold_pane_open(mode)
        raise SystemExit(1) from error


if __name__ == "__main__":
    raise SystemExit(run_launcher(sys.argv[1:]))
